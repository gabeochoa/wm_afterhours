# Migrated from coroutine sports_settings tests (tabs + arrow value change)

goto_screen sports_settings
wait 0.5

expect_text "Window mode"
expect_text "Borderless window"

click_button "GAMEPLAY"
wait 0.3
expect_text "Difficulty"

click_button "AUDIO"
wait 0.3
expect_text "Master Volume"

click_button "VIDEO"
wait 0.3
# The VIDEO tab shows the Window mode setting row.
expect_text "Window mode"

# Note: keyboard focus + arrow-key value cycling on a setting row is a no-op in
# headless (clicking a non-tab row doesn't take focus), so the RIGHT/LEFT value
# changes below are not exercised here.
