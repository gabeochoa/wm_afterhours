# Migrated from coroutine sports_settings tests (tabs + value change)

goto_screen sports_settings
wait 0.5

expect_text "Window mode"
expect_text "Borderless window"

click_ui sports_tab_0
wait 0.3
expect_text "Difficulty"

click_ui sports_tab_2
wait 0.3
expect_text "Master volume"

click_ui sports_tab_1
wait 0.3
expect_text "Window mode"

click_ui sports_row_4
key RIGHT
wait 0.2
expect_text "132"

click_ui sports_reset
wait 0.2
expect_text "Defaults restored"
expect_text "120"
