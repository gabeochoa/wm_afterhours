# Layout Test
# Tests layout system rendering

# Navigate to the layout screen
goto_screen layout
wait 0.5

# Validate screen against baseline
validate_screen layout

# Verify we're on the correct screen
expect_text "Layout"

assert_ui layout_main x=48 y=24 w=1184 h=672
assert_ui row_container x=72 y=156 w=1136 h=120
assert_ui layout_row_item_0 w=180 h=80
assert_ui layout_row_item_1 w=180 h=80
assert_ui layout_row_item_2 w=180 h=80
assert_ui col_demo_container x=72 y=364 w=1136 h=220
assert_ui layout_column_item_0 h=40
assert_ui layout_column_item_1 h=40
assert_ui layout_column_item_2 h=40
assert_ui layout_title h=43
assert_ui section_separator_1 w=1136 h=1
assert_ui section_separator_2 w=1136 h=1
assert_ui layout_metadata h=26
assert_no_overflow
assert_within_parents

screenshot layout_display

