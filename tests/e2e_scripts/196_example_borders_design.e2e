focus_ui border_live
key ENTER
wait 0.2
expect_text "Button activations: 2"
click_ui borders_page_2
wait 0.2
expect_text "Per-side borders"
expect_text "Left and right"
expect_text "Top blue 3 / right cyan 2"
expect_text "Bottom orange 3 / left white 2"
expect_text "1px / dash 2 / gap 2"
expect_text "3px / dash 6 / gap 6"
expect_text "6px / dash 12 / gap 12"
expect_text "4px / dash 8 / gap 8"
assert_ui edge_0 x=60 y=211 w=208 h=100
assert_ui dotted_4 x=1004 y=481 w=208 h=100
