goto_screen example_borders
resize 1280 720
wait 0.3
click_ui borders_page_0
wait 0.2
expect_text "Border styles"
expect_text "Width / requested thickness"
expect_text "1px requested"
expect_text "3px requested"
expect_text "6px requested"
expect_text "#5091DC"
expect_text "#46BEC8"
expect_text "#EB9146"
expect_text "Bottom corners"
expect_text "Top-left + bottom-right"
expect_text "0.25 / radius 12.5px"
expect_text "Offset 5,5 / no blur"
expect_text "Offset 4,6 / blur 14"
expect_text "Capsule 1.0 / r18px"
assert_ui borders_root x=60 y=0 w=1160 h=720
assert_ui border_0 x=60 y=192 w=100 h=100
assert_ui corner_2 x=444 y=417 w=100 h=100
assert_ui true_capsule x=252 y=593 w=160 h=36
assert_within_parents
screenshot example_borders_width_corners
focus_ui borders_page_1
key ENTER
wait 0.2
expect_text "Themed treatments"
expect_text "Neon glow"
expect_text "Warm fill / blur 10"
expect_text "Outline only"
expect_text "Rest"
expect_text "Hover"
expect_text "Pressed"
expect_text "Hover and pressed share the same fill"
expect_text "Button activations: 0"
assert_ui theme_0 w=100 h=100
assert_ui border_live x=60 y=439 w=220 h=56
assert_ui nested_outer x=928 y=439 w=280 h=110
assert_ui nested_filled x=944 y=482 w=120 h=55
assert_ui nested_outline x=1078 y=482 w=100 h=55
assert_within_parents
