goto_screen flex_alignment
resize 1280 720
wait 0.3
click_ui tab_0
wait 0.2
expect_text "Flexbox alignment"
expect_text "Overview"
expect_text "Within each set, only the layout rule changes. Dimensions use 720p design pixels."
expect_text "JustifyContent / Column / main axis down"
expect_text "JustifyContent / Row / main axis right"
expect_text "Before snapping: inner gap = 2 x edge gap + base gap."
expect_text "AlignItems / heights: 50%, 30%, 40% of content height"
expect_text "SelfAlign / parent AlignItems::Center"
expect_text "Auto inherits the parent"
assert_ui root x=60 y=0 w=1160 h=720
assert_ui category_tabs x=60 y=111 w=1160 h=38
assert_ui vertical_0 w=104 h=168
