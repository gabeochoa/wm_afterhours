# Neon Strike faithful layout: centered square stage, icon rail, minimap.
goto_screen neon_strike
resize 1280 720
wait 0.5
assert_ui neon_root x=280 y=0 w=720 h=720
assert_ui neon_reload x=506 y=566 w=190 h=46
expect_text "35/210"
expect_text "KILLSTREAK"
assert_no_overflow
assert_within_parents
click_ui neon_reload
wait 0.2
expect_text "40/205"
expect_text "Weapon reloaded"
click_ui neon_reload
wait 0.2
expect_text "40/205"
expect_text "Magazine full"
click_ui neon_ability_1
wait 0.2
expect_text "Recon selected"
focus_ui neon_ability_0
key ENTER
wait 0.2
expect_text "UAV selected"
key 4
wait 0.2
expect_text "Strike selected"
click_ui neon_melee
wait 0.2
expect_text "Melee selected"
focus_ui neon_grenade
key ENTER
wait 0.2
expect_text "Grenade selected"
screenshot neon_strike_selected
resize 1920 1080
wait 0.3
assert_ui neon_root x=420 y=0 w=1080 h=1080
assert_ui neon_reload x=759 y=849 w=285 h=69
assert_no_overflow
assert_within_parents
key R
wait 0.2
expect_text "Magazine full"
