# The timings move every run, so nothing here asserts a number: the baseline is
# the stopped state, and the check is that rows appear at all once started.
# Every name in them belongs to a system this screen did not write.

goto_screen system_profile_lab
wait 0.4
key TAB
focus_element spl_load
wait 0.2
validate_screen system_profile_lab

click_ui profiler_record
wait 0.8
expect_text "Recording in background"
expect_text "ScreenCyclerSystem / update"
assert_within_parents

click_ui profiler_record
wait 0.3
