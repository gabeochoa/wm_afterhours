# Forms and Slider Test
# Tests form components including sliders

# Navigate to the forms screen
goto_screen forms
wait 0.5

# Validate initial screen against baseline
validate_screen forms

# Verify we're on the correct screen
expect_text "Form Components"

# Tab to a slider component
key TAB
wait 0.2

# Adjust slider with arrow keys
key RIGHT
wait 0.1
key RIGHT
wait 0.1
key RIGHT
wait 0.3

# Take screenshot after slider adjustment
screenshot forms_after_slider


# The script was named for a slider it never asserted. Drag the track and check
# the value moved, on the screen whose slider reads the returned changed flag.
goto_screen setting_row_showcase
resize 1280 720
wait 0.5
expect_text "80%"
drag_to 836 540 608 540
wait 0.5
expect_text "Music preview: 13%"
