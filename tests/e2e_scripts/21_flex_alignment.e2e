# Flex Alignment Test
# Tests flex alignment system rendering

# Navigate to the flex alignment screen
goto_screen flex_alignment
wait 0.5

# Validate screen against baseline
validate_screen flex_alignment

# Verify we're on the correct screen
expect_text "Flexbox alignment"
expect_text "Vertical"
expect_text "Horizontal"
expect_text "Self align"

# Layout assertions based on source code math (1280x720 screen)
# Root uses a centered 1160 x 720 design canvas.
assert_ui root w=1160 h=720

# Title has a 44px design height.
assert_ui_text "Flexbox alignment" h=44

# Native category tabs use a 38px design height.

screenshot flex_alignment_display

