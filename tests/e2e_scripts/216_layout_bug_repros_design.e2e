click_ui inspect_case_1
click_ui tab_0
wait 0.2
expect_text "Layout regression fixtures"
expect_text "Retained cases / badges state current expectations"
expect_text "Origin 0,0 at red +"
expect_text "Case inspector / 1-5 left, 6-7 right"
expect_text "Parent 300 x 80px / child 100% x 60px"
expect_text "Expected: red width matches cyan."
expect_text "Expected width match"
expect_text "Drawn parent: 300 x 80px at x20, y67"
assert_ui r1_parent x=20 y=67 w=300 h=80
assert_ui r1_child w=300 h=60
assert_ui r2_parent x=20 y=182 w=600 h=80
assert_ui r2_A w=100 h=60
assert_ui r2_B w=100 h=60
assert_ui r2_C w=100 h=60
assert_ui r3_parent x=400 y=312 w=300 h=100
assert_ui r3_child1 w=280 h=35
assert_ui r3_child2 w=280 h=35
assert_ui r3_origin_marker x=0 y=0 w=20 h=20
assert_ui r4_red x=20 y=462 w=200
assert_ui r4_blue x=100 y=482 w=200
assert_ui r5_auto x=20 y=592 h=40
assert_ui r5_manual x=20 y=638 h=40
assert_ui r6_parent x=700 y=67 w=500 h=60
assert_ui r7_parent x=700 y=182
assert_within_parents
screenshot layout_repros_percent
click_ui inspect_case_2
wait 0.2
expect_text "Three separate children use 300px; 300px remains free."
click_ui inspect_case_3
wait 0.2
expect_text "Parent x400, y312, 300 x 100px; children 280 x 35px."
expect_text "Children follow the parent offset, away from the origin."
click_ui inspect_case_4
wait 0.2
expect_text "Blue covers red. Creation order determines this overlap."
expect_text "Red / mk(5000) / created first"
expect_text "Blue / mk(2000) / created second"
expect_text "mk ID identifies an entity; it does not set render depth."
screenshot layout_repros_creation_order
