wait 0.2
expect_text "Selected: Tab A / expected inside green bounds"
click_ui tab_1
wait 0.2
expect_text "Selected: Tab B / expected inside green bounds"
focus_ui tab_2
key ENTER
wait 0.2
expect_text "Selected: Tab C / expected inside green bounds"
