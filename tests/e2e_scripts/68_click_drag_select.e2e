# Feature: Click-drag to create text selection
# Expected: Pressing mouse at one position and dragging to another
# should select the text between those two positions.

goto_screen text_input
wait 0.5

focus_ui Username_input
wait 0.2
type "Hello World"
wait 0.3
screenshot drag_select_01_before

# Drag from the start of "Hello" to end of "Hello" (select "Hello")
# Field is approximately x=350..670, y=107..143
# Start of text ~x=370, end of "Hello" ~x=420
drag 370 120 420 120
wait 0.3
screenshot drag_select_02_dragged_hello

# The word "Hello" should be selected
# Type to replace selection
type "Goodbye"
wait 0.2
screenshot drag_select_03_replaced

expect_input_text Username_input "Goodbye World"
