# Responsive Audit - Test migrated screens at 720p and 1080p
# Verifies no UI elements overflow the viewport at minimum supported resolution
# and at a common larger resolution.

# ── sports_settings ──
goto_screen sports_settings
wait 0.5
resize 1280 720
wait 0.3
assert_no_overflow
screenshot responsive_sports_settings_720p
resize 1920 1080
wait 0.3
assert_no_overflow
screenshot responsive_sports_settings_1080p

