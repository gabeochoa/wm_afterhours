# Circular Progress Test
# Tests circular progress component rendering

# Navigate to the circular progress screen
goto_screen circular_progress
wait 0.5
click_ui circular_pause
click_ui circular_reset
mouse_move 1270 710
wait 0.2

# Validate initial screen against baseline
validate_screen circular_progress

# Verify we're on the correct screen
expect_text "Circular"

screenshot circular_progress_display

