# Empire Tycoon faithful layout: centered square stage.
goto_screen empire_tycoon
resize 1280 720
wait 0.5
expect_text "DREAM"
expect_text "INCORPORATED"
expect_text "$1,250,980"
expect_text "Production Overview"
expect_text "Current Projects"
expect_text "Toys: 5,200/min"
expect_text "New Rollercoaster - 80%"
expect_text "Expand - 35%"
expect_text "Happiness"
expect_text "Next Milestone"
assert_ui empire_root x=0 y=0 w=1280 h=720
assert_ui empire_cash_pill x=672 y=16 w=312 h=60
assert_ui empire_tabs_panel x=296 y=172 w=104 h=352
assert_ui empire_tab_0 x=304 y=182 w=88 h=60
assert_ui empire_dashboard x=414 y=180 w=570 h=320
assert_ui empire_production_list x=430 y=236 w=262 h=150
assert_ui empire_project_list x=712 y=236 w=262 h=150
assert_ui empire_action_0 x=426 y=512 w=176 h=44
click_ui empire_tab_2
wait 0.2
expect_text "Upgrades department selected"
click_ui empire_tab_4
wait 0.2
expect_text "Finance department selected"
click_ui empire_action_0
wait 0.2
expect_text "$1,275,980"
expect_text "Toys: 5,600/min"
expect_text "Production boosted!"
click_ui empire_action_1
wait 0.2
expect_text "$1,270,980"
expect_text "New Rollercoaster - 95%"
expect_text "New Rollercoaster prioritized"
click_ui empire_action_2
wait 0.2
expect_text "$1,258,980"
expect_text "Sky Garden"
expect_text "New project started"
click_ui empire_tool_1
wait 0.2
expect_text "Settings opened"
screenshot empire_tycoon_review
resize 1920 1080
wait 0.3
assert_ui empire_root x=0 y=0 w=1920 h=1080
assert_ui empire_cash_pill x=1008 y=24 w=468 h=90
assert_ui empire_dashboard x=621 y=270 w=855 h=480
assert_ui empire_action_0 x=639 y=768 w=264 h=66
