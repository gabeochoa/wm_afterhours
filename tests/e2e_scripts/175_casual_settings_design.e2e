goto_screen casual_settings
resize 1280 720
wait 0.3
expect_text "AUDIO"
expect_text "MUSIC"
expect_text "SOUND EFFECTS"
expect_text "VIBRATION"
expect_text "PROGRESS SAVE"
expect_text "Save or restore this session"
expect_text "Saved slot: level 8 / 650 coins"
expect_text "HELP & ABOUT"
expect_text "English"
expect_text "Build"
expect_text "1.11.0.12346"
expect_text "281 676 956 389"
expect_text "Preferences apply immediately. Kept for this session."
expect_no_text "CLOUD SAVE"
assert_ui casual_music x=244 y=185 w=102 h=70
assert_ui casual_progress x=654 y=183 w=396 h=77
assert_ui casual_notifications x=231 y=332 w=396 h=66
