wait 0.2
click_ui casual_language_2
click_ui casual_language_apply
wait 0.3
expect_text "French"
click_ui casual_close
wait 0.2
expect_text "Ready for another adventure?"
click_ui casual_reopen
wait 0.2
expect_text "French"
click_ui casual_vibration
wait 0.1
expect_text "Vibration off"
click_ui casual_notifications
wait 0.1
expect_text "Notifications disabled"
click_ui casual_progress
wait 0.2
expect_text "Saved progress: level 8 / 650 coins"
click_ui casual_save
wait 0.2
