click_ui casual_dialog_close
wait 0.2
expect_text "Saved slot: level 12 / 1000 coins"
click_ui casual_terms
wait 0.2
expect_text "Your preferences and progress last for this demo session."
expect_text "No account, advertising or cloud sync is used."
key ESCAPE
wait 0.2
resize 1920 1080
wait 0.3
