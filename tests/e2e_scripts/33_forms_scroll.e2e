# Forms Scroll Test
# Verifies that the right column (checkboxes) is scrollable
# and that off-screen items become visible after scrolling

goto_screen forms
wait 0.5

# Verify we're on the forms screen
expect_text "Form Components"
expect_text "Sliders"
expect_text "Checkboxes"

# Top checkboxes should be visible initially
expect_text "Music"
expect_text "SFX"
expect_text "Fullscreen"

# Bottom items should NOT be visible (they overflow)
expect_no_text "Bloom Effect"
expect_no_text "Ambient Occlusion"

screenshot forms_before_scroll

# Move mouse into the right column (checkboxes area)
mouse_move 75% 45%
wait 0.2

# Scroll down to reveal bottom items
scroll_wheel 0 -10
wait 0.3

# After scrolling, bottom checkboxes should now be visible
expect_text "Bloom Effect"

screenshot forms_after_scroll
