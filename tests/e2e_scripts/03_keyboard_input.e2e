# Keyboard Input Test
# Tests semantic actions for navigation

# Navigate to the text input screen
goto_screen text_input
wait 0.5

# Verify we're on the text input screen
expect_text "Edit Profile"

# Focus the save button directly
focus_element btn_save
wait 0.2

# Press Enter to submit
key ENTER
wait 0.3

# Should show saved message (empty form)
expect_text "Saved:"

screenshot keyboard_input_test
