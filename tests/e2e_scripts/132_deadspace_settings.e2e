# Dead Space settings mock parity smoke test.

goto_screen deadspace_settings
resize 1280 720
wait 1

expect_text "MORE SETTINGS"
expect_text "INITIAL SETTINGS > MORE SETTINGS"
expect_text "INITIAL SETTINGS"
expect_text "More Settings"
expect_text "Gameplay"

assert_ui ds_root x=0 y=0 w=1280 h=720
assert_ui ds_back_layer x=64 y=188 w=325 h=350
assert_ui ds_front_header x=338 y=114 w=465 h=40
assert_ui ds_category_1 x=338 y=213 w=465 h=44
assert_ui ds_front_footer x=338 y=586 w=465 h=54

click_ui ds_category_3
wait 0.2
expect_text "Master volume"
expect_text "Dynamic range"
expect_text "80"
assert_ui ds_detail_panel x=844 y=164 w=380
assert_ui ds_detail_row_0 x=864 y=270 w=340

click_ui ds_cycle_next_0
wait 0.2
expect_text "90"

action WidgetDown
wait 0.2
expect_text "Voice language"
expect_text "Subtitle size"

click_ui ds_cycle_next_1
wait 0.2
expect_text "Spanish"

click_ui ds_detail_back
wait 0.2
screenshot deadspace_settings_review

resize 1920 1080
wait 0.3
assert_ui ds_root x=0 y=0 w=1920 h=1080
assert_ui ds_back_layer x=96 y=282 w=488 h=525
assert_ui ds_front_header x=507 y=171 w=698 h=60
assert_ui ds_category_4 x=507 y=531 w=698 h=66
assert_ui ds_front_footer x=507 y=879 w=698 h=81
