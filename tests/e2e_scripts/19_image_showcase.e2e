# Image Showcase Test
# Tests image, sprite, and image_button components

# Navigate to the images screen
goto_screen images
resize 1280 720
wait 0.5

# Validate initial screen against baseline
validate_screen images

# Verify we're on the correct screen
expect_text "Image & Sprite Components"

focus_element imgbtn_1
key ENTER
wait 0.3

# Verify click was registered
expect_text "Clicks: 1"

# Take screenshot after click
screenshot images_after_click

