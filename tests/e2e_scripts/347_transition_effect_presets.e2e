wait 1.5
expect_text "progress: 100%"
expect_text "motion: settled"
screenshot effect_preset_wipe
click_ui ex_flip
mouse_move 20 20
expect_text "effect: flip"
click_ui replay_btn
mouse_move 20 20
expect_text "motion: in flight"
wait 1.5
expect_text "progress: 100%"
screenshot effect_preset_flip
click_ui ex_emerge
mouse_move 20 20
expect_text "effect: emerge"
click_ui ex_blur
mouse_move 20 20
expect_text "effect: blur"
expect_text "shader: n/a"
