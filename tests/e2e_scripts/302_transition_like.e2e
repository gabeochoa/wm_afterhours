goto_screen transitions_lab
resize 1280 720
mouse_move 20 20
wait 0.3
click_ui group_controls
click_ui ex_like
mouse_move 20 20
wait 0.3
expect_text "Like button"
expect_text "liked: no"
expect_text "likes: 0"
expect_text "motion: settled"
click_ui like_btn
mouse_move 20 20
expect_text "motion: in flight"
expect_text "liked: yes"
expect_text "likes: 1"
wait 2
expect_text "motion: settled"
expect_drawn triangle color=#f40051
screenshot transition_like_liked
click_ui like_btn
mouse_move 20 20
expect_text "liked: no"
wait 1
expect_text "motion: settled"
expect_drawn triangle color=#aaa5af
expect_text "likes: 1"
click_ui reset_btn
mouse_move 20 20
wait 0.5
expect_text "likes: 0"
