# Containment, which assert_no_overflow does not check: it asks whether an
# element is on screen, not whether it is inside its own parent. A row
# overflowing a panel mid-screen passes that and fails this.
#
# Only screens known to hold at both sizes. The rest of the settings screens
# mix with_720p_size children with fixed-pixel parents and come apart above 1x
# scale; see docs/POLISH_PASS_AFTERHOURS_GAPS.md.

goto_screen casual_settings
wait 0.5
resize 1280 720
wait 0.3
assert_within_parents
resize 1920 1080
wait 0.3
assert_within_parents

goto_screen simple_button
wait 0.5
resize 1280 720
wait 0.3
assert_within_parents
resize 1920 1080
wait 0.3
assert_within_parents
