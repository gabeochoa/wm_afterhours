goto_screen rubber_bandits_menu
resize 1280 720
wait 0.4
expect_text "thia9uers - Online"
expect_text "OPTIONS"
expect_text "PLAY CREDITS"
expect_text "BACK"
expect_text "Get more bandits!"
expect_text "Buy the supporter pack"
expect_text "EARL THE BIRD"
expect_text "FAVOURITE"
expect_no_text "Enter  Select"
assert_ui rb_root x=0 y=0 w=1280 h=720
assert_ui rb_online_bar x=0 y=0 w=1280 h=40
assert_ui rb_logo x=52 y=78 w=330 h=183
assert_ui rb_menu_0 x=48 y=300 w=354 h=42
assert_ui rb_menu_2 x=48 y=380 w=354 h=42
assert_ui rb_menu_5 x=48 y=500 w=354 h=42
assert_ui rb_menu_6 x=48 y=560 w=354 h=42
assert_ui rb_character_panel x=468 y=608 w=764 h=60
assert_ui rb_character_prev x=486 y=622 w=48 h=32
assert_ui rb_character_next x=1166 y=622 w=48 h=32
assert_ui rb_footer x=0 y=678 w=1280 h=42
assert_no_overflow
assert_within_parents
screenshot rubber_bandits_menu
click_ui rb_menu_1
wait 0.2
expect_text "Learn the controls"
focus_ui rb_menu_3
key ENTER
wait 0.2
expect_text "Choose your loadout"
click_ui rb_menu_4
wait 0.2
expect_text "Report a player"
click_ui rb_menu_5
wait 0.2
expect_text "Meet the team"
click_ui rb_menu_6
wait 0.2
expect_text "OPEN MENU"
expect_no_text "PLAY CREDITS"
click_ui rb_open_menu
wait 0.2
expect_text "OPTIONS"
key ESCAPE
wait 0.2
expect_text "OPEN MENU"
key ESCAPE
wait 0.2
expect_text "BACK"
click_ui rb_character_prev
wait 0.2
expect_text "THE OUTLAW"
click_ui rb_character_next
wait 0.2
expect_text "EARL THE BIRD"
focus_ui rb_character_next
key ENTER
wait 0.2
expect_text "THE GENTLEMAN"
click_ui rb_character_next
wait 0.2
expect_text "HOT HEAD"
click_ui rb_promo
wait 0.2
expect_text "Cosmetic pack preview"
expect_text "No purchase in this demo"
assert_no_overflow
screenshot rubber_bandits_menu_pack
click_ui rb_promo
wait 0.2
expect_text "Get more bandits!"
resize 1920 1080
wait 0.3
assert_ui rb_root x=0 y=0 w=1920 h=1080
assert_ui rb_menu_0 x=72 y=450 w=531 h=63
assert_ui rb_character_panel x=702 y=912 w=1146 h=90
assert_no_overflow
assert_within_parents
screenshot rubber_bandits_menu_1080
resize 1024 768
wait 0.3
assert_ui rb_root x=0 y=96 w=1024 h=576
assert_no_overflow
assert_within_parents
screenshot rubber_bandits_menu_narrow
resize 1280 720
