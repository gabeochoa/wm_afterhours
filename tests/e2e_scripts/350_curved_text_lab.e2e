goto_screen curved_text_lab
resize 1280 720
mouse_move 20 20
expect_text "Curved text: grapheme-aware arc layout"
expect_text "Arc size: 190"
expect_text "at rest"
set_slider curved_arc_size 0.2
expect_text "Arc size: 144"
click_ui curved_language
wait 0.2
click_ui dropdown_opt_1
expect_text "Arc size: 144"
click_ui curved_direction
click_ui curved_spin
wait 1
expect_text "spinning"
click_ui curved_spin
click_ui curved_rotate
click_ui curved_reset
expect_text "Arc size: 190"
expect_text "at rest"
screenshot curved_text_lab
