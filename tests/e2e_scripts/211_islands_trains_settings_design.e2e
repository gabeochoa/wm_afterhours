goto_screen islands_trains_settings
resize 1280 720
wait 0.4
expect_text "SETTINGS"
expect_text "DISPLAY"
expect_text "CONTROLS"
expect_text "AUDIO"
expect_text "TUTORIAL"
expect_text "Cam panning speed"
expect_text "Cam rotating speed"
expect_text "KEYBOARD"
expect_text "Effects Volume"
expect_text "Music Volume"
expect_text "2560x1440"
assert_ui it_root x=0 y=0 w=1280 h=720
assert_ui it_paper x=420 y=0 w=440 h=720
assert_ui it_close x=1206 y=16 w=56 h=56
assert_ui it_title x=450 y=18 w=380 h=48
assert_ui it_mode_row x=448 y=134 w=384 h=38
assert_ui it_resolution_row x=448 y=180 w=384 h=38
assert_ui it_mode_prev x=652 y=136 w=32 h=34
assert_ui it_mode_next x=792 y=136 w=32 h=34
assert_ui it_pan_row x=448 y=266 w=384 h=38
assert_ui it_rotate_row x=448 y=312 w=384 h=38
assert_ui it_pan_segment_1 x=688 y=266 w=10 h=38
assert_ui it_pan_segment_10 x=778 y=266 w=10 h=38
assert_ui it_keyboard x=448 y=358 w=384 h=36
assert_ui it_effects_row x=448 y=440 w=384 h=38
assert_ui it_music_row x=448 y=486 w=384 h=38
assert_ui it_play_tutorial x=448 y=578 w=384 h=36
assert_ui it_reset x=448 y=672 w=384 h=36
assert_no_overflow
assert_within_parents
screenshot islands_trains_settings_design
click_ui it_mode_prev
wait 0.2
expect_text "Fullscreen"
click_ui it_resolution_prev
wait 0.2
expect_text "1920x1080"
click_ui it_resolution_next
click_ui it_resolution_next
wait 0.2
expect_text "3840x2160"
click 770 286
wait 0.2
click_ui it_pan_next
click_ui it_pan_next
click_ui it_pan_next
click_ui it_pan_next
click_ui it_pan_next
click_ui it_pan_next

wait 0.2
click_ui it_pan_prev
wait 0.2
click_ui it_rotate_prev
click_ui it_rotate_prev
click_ui it_rotate_prev
click_ui it_rotate_prev
click_ui it_rotate_prev
click_ui it_rotate_prev

wait 0.2
click_ui it_effects_next
click_ui it_effects_next
click_ui it_effects_next

click_ui it_music_prev
wait 0.2
focus_ui it_reset
key ENTER
wait 0.2
expect_text "Borderless"
expect_text "2560x1440"
click_ui it_keyboard
wait 0.2
expect_text "Keyboard controls for this mock"
expect_text "Tab / Shift+Tab"
click_ui it_detail_back
wait 0.2
click_ui it_play_tutorial
wait 0.2
expect_text "1. Move the camera"
click_ui it_tutorial_right
wait 0.2
expect_text "Step complete!"
click_ui it_tutorial_next
wait 0.2
expect_text "2. Lay the track"
click_ui it_tutorial_track
wait 0.2
expect_text "TRACK CONNECTED"
click_ui it_tutorial_next
wait 0.2
expect_text "3. Send a train"
click_ui it_tutorial_train
wait 3
expect_text "TRAIN ARRIVED"
click_ui it_tutorial_next
wait 0.2
expect_text "SETTINGS"
click_ui it_close
wait 0.2
expect_text "Settings closed"
click_ui it_reopen
wait 0.2
expect_text "SETTINGS"
resize 1920 1080
wait 0.3
assert_ui it_paper x=630 y=0 w=660 h=1080
