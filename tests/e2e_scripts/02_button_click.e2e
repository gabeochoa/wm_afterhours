# Button Click Test
# Tests clicking buttons on the buttons gallery screen

goto_screen buttons
wait 0.5

expect_text "Button Gallery"
expect_text "Try any button above"

# Layout assertions based on source code math (1280x720 screen)
# Root panel: 1144 x 676 at the reference viewport.
assert_ui buttons_bg w=1144 h=676

# Row heights (all specified in pixels())
assert_ui row1_states h=116
assert_ui row2_sizes h=122
assert_ui row3_group h=102
assert_ui row4_custom h=136

# Button dimensions (all specified in pixels())
assert_ui btn_normal w=120 h=45
assert_ui btn_accent w=120 h=45
assert_ui btn_secondary w=120 h=45
assert_ui btn_small w=90 h=45
assert_ui btn_medium w=120 h=45
assert_ui btn_large w=180 h=60
assert_ui btn_coral w=120 h=45
assert_ui btn_teal w=120 h=45

# Group buttons: pixels(90) x pixels(45)
assert_ui btn_group_0 w=90 h=45
assert_ui btn_group_1 w=90 h=45
assert_ui btn_group_2 w=90 h=45
assert_ui btn_group_3 w=90 h=45

# Title: 1104 x 42 at the reference viewport.
assert_ui_text "Button Gallery" h=42

# Click the Primary button
focus_ui btn_normal
wait 0.2
key ENTER
wait 0.3

expect_text "1 pressed so far"

# Click Accent button
focus_ui btn_accent
wait 0.2
key ENTER
wait 0.3

expect_text "2 pressed so far"

# Click Secondary button
focus_ui btn_secondary
wait 0.2
key ENTER
wait 0.3

expect_text "3 pressed so far"

screenshot button_click_test
