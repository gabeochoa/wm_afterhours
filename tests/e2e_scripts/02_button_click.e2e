# Button Click Test
# Tests clicking buttons on the buttons gallery screen

goto_screen buttons
wait 0.5

expect_text "Button Gallery"
expect_text "Total clicks across all buttons: 0"

# Click the Normal button
focus_ui btn_normal
wait 0.2
key ENTER
wait 0.3

expect_text "Total clicks across all buttons: 1"

# Click Accent button
focus_ui btn_accent
wait 0.2
key ENTER
wait 0.3

expect_text "Total clicks across all buttons: 2"

# Click Secondary button
focus_ui btn_secondary
wait 0.2
key ENTER
wait 0.3

expect_text "Total clicks across all buttons: 3"

screenshot button_click_test
