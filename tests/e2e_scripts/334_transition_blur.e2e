goto_screen transitions_lab
resize 1280 720
mouse_move 20 20
wait 0.3
click_ui group_effects
click_ui ex_blur
mouse_move 20 20
wait 0.5
expect_text "Blur"
expect_text "blur: off"
expect_text "radius: 0px"
click_ui blur_btn
mouse_move 20 20
expect_text "motion: in flight"
expect_text "blur: on"
wait 1.5
expect_text "motion: settled"
expect_text "radius: 6px"
screenshot transition_blur_on
click_ui blur_btn
mouse_move 20 20
wait 1.5
expect_text "radius: 0px"
