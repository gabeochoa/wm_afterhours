goto_screen deadspace_settings
resize 1280 720
wait 0.4
expect_text "MORE SETTINGS"
expect_text "INITIAL SETTINGS > MORE SETTINGS"
expect_text "INFORMATION"
expect_text "Enter"
expect_text "Esc"
expect_text "Set difficulty, objectives,"
expect_text "4 entries / Enter to open"
assert_ui ds_root x=0 y=0 w=1280 h=720
assert_ui ds_front_header x=338 y=114 w=465 h=40
assert_ui ds_category_7 x=338 y=517 w=465 h=44
assert_ui ds_front_footer x=338 y=586 w=465 h=54
assert_ui ds_preview_panel x=844 y=164 w=380 h=248
assert_within_parents
