wait 0.2
expect_text "Colourblind mode"
click_ui ds_cycle_next_1
wait 0.2
expect_text "Deuteranopia"
assert_ui ds_detail_value_1 x=918 y=372 w=232 h=31
assert_within_parents
screenshot deadspace_accessibility
click_ui ds_detail_back
wait 0.2
action WidgetUp
wait 0.2
expect_text "Choose voice and text languages,"
action WidgetPress
wait 0.2
expect_text "Voice language"
expect_text "Subtitle size"
click_ui ds_cycle_next_1
wait 0.2
expect_text "Spanish"
key ESCAPE
wait 0.2
expect_no_text "Subtitle size"
expect_text "MORE SETTINGS"
key ESCAPE
wait 0.2
expect_no_text "INITIAL SETTINGS > MORE SETTINGS"
