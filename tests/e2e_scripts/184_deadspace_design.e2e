goto_screen deadspace_settings
resize 1280 720
wait 0.4
expect_text "MORE SETTINGS"
expect_text "// SETTINGS"
expect_text "Enter"
expect_text "Esc"
expect_no_text "INFORMATION"
expect_no_text "Set difficulty, objectives,"
assert_ui ds_root x=0 y=0 w=1280 h=720
assert_ui ds_front_header x=358 y=114 w=425 h=40
assert_ui ds_category_7 x=358 y=495 w=425 h=44
assert_ui ds_front_footer x=358 y=586 w=425 h=54
assert_within_parents
screenshot deadspace_design
click_ui ds_category_3
wait 0.2
expect_text "Master volume"
expect_text "80"
click_ui ds_cycle_next_0
wait 0.2
expect_text "90"
click_ui ds_cycle_prev_3
wait 0.2
expect_text "Full"
click_ui ds_detail_back
wait 0.2
expect_no_text "Balance music and effects,"
expect_no_text "Master volume"
click_ui ds_category_3
wait 0.2
expect_text "90"
expect_text "Full"
click_ui ds_category_5
wait 0.2
expect_text "Colourblind mode"
click_ui ds_cycle_next_1
wait 0.2
expect_text "Deuteranopia"
assert_ui ds_detail_value_1 x=918 y=372 w=232 h=31
assert_within_parents
screenshot deadspace_accessibility
click_ui ds_detail_back
wait 0.2
action WidgetUp
wait 0.2
expect_no_text "Choose voice and text languages,"
action WidgetPress
wait 0.2
expect_text "Voice language"
expect_text "Subtitle size"
click_ui ds_cycle_next_1
wait 0.2
expect_text "Spanish"
key ESCAPE
wait 0.2
expect_no_text "Subtitle size"
expect_text "MORE SETTINGS"
key ESCAPE
wait 0.2
expect_no_text "// SETTINGS"
assert_ui ds_back_layer x=448 y=188 w=290 h=350
assert_ui ds_initial_7 x=448 y=487 w=290 h=31
expect_text "More Settings / Enter to return"
screenshot deadspace_initial_back
click_ui ds_initial_7
wait 0.2
expect_text "// SETTINGS"
expect_no_text "Choose voice and text languages,"
resize 1920 1080
wait 0.3
assert_ui ds_root x=0 y=0 w=1920 h=1080
assert_ui ds_front_header x=537 y=171 w=638 h=60
assert_within_parents
