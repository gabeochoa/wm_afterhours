goto_screen cozy_cafe
resize 1280 720
wait 0.4
expect_text "Blossom Cafe"
expect_text "Gold: 1347"
expect_no_text "Selected"
expect_no_text "Patience"
expect_no_text "LOW"
expect_no_text "50%"
expect_no_text "Guild chat"
expect_no_text "2 notices"
expect_text "Customers Served: 23"
expect_text "Lavender Latte"
expect_text "Promote Special"
expect_text "Serve Next"
expect_text "Music: 70%"
assert_ui paper_board x=290 y=15 w=700 h=690
assert_ui special_0 x=336 y=215 w=261 h=57
assert_ui promote_special x=336 y=410 w=261 h=46
assert_ui customer_row_0 x=666 y=219 w=279 h=88
assert_ui customer_row_1 x=666 y=314 w=279 h=88
assert_ui prog_bg_0 w=167 h=12
assert_ui music_slider x=426 y=537 w=249 h=36
assert_no_overflow
assert_within_parents
screenshot cozy_cafe_design
click_ui special_2
wait 0.2
expect_text "Promote Special"
focus_ui special_2
key TAB
wait 0.2
expect_focused promote_special
key ENTER
wait 0.2
expect_text "Matcha Cake promoted"
expect_text "Gold: 1372"
click_ui serve_next
wait 0.2
expect_text "Customers Served: 24"
expect_text "Gold: 1384"
expect_no_text "Cappuccino"
click_ui serve_next
wait 0.2
expect_text "All orders served"
expect_text "Customers Served: 25"
expect_text "Gold: 1396"
click_ui serve_next
wait 0.2
expect_text "Gold: 1396"
set_slider music_slider 0
wait 0.2
expect_text "Music: 0%"
set_slider music_slider 1
wait 0.2
expect_text "Music: 100%"
set_slider music_slider 0.35
wait 0.2
expect_text "Music: 35%"
click_ui tool_Inventory
wait 0.2
expect_text "Inventory opened"
expect_text "Pantry: stock check due"
click_ui tool_close
wait 0.2
click_ui tool_Research
wait 0.2
expect_text "Recipe notebook: try a lavender latte."
click_ui tool_close
wait 0.2
click_ui tool_Crafting
wait 0.2
expect_text "Your crafting station has no new notices."
click_ui tool_close
resize 1920 1080
wait 0.3
assert_ui paper_board x=435 y=23 w=1050 h=1035
assert_no_overflow
assert_within_parents
screenshot cozy_cafe_design_1080
resize 1024 768
wait 0.3
assert_ui cafe_background w=1024 h=768
assert_no_overflow
assert_within_parents
screenshot cozy_cafe_design_narrow
resize 1280 720
