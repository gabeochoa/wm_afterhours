goto_screen mini_motorways_settings
resize 1280 720
wait 0.4
expect_text "Night Mode"
expect_text "Hold to Draw/Delete"
expect_text "Mini Motorways release-10-patch-2 (202207010917)"
assert_ui mm_canvas w=1280 h=720
assert_ui mm_root x=0 y=0 w=1280 h=720
assert_ui mm_back x=28 y=24 w=78 h=78
assert_ui mm_tab_0 x=212 y=138 w=176 h=52
assert_ui mm_tab_3 x=128 y=309 w=260 h=52
assert_ui mm_tab_5 x=86 y=423 w=302 h=52
assert_ui mm_night x=884 y=150 w=58 h=58
assert_ui mm_sensitivity_left x=884 y=426 w=52 h=52
assert_ui mm_sensitivity_right x=1110 y=426 w=52 h=52
assert_ui mm_separator x=500 y=500 w=662 h=2
assert_ui mm_tutorial x=1042 y=642 w=196 h=52
assert_no_overflow
assert_within_parents
screenshot mini_motorways_settings_design
focus_ui mm_night
key ENTER
wait 0.2
expect_text "Night Mode on"
assert_no_overflow
screenshot mini_motorways_settings_design_night
click_ui mm_night
click_ui mm_colorblind
wait 0.3
screenshot mini_motorways_settings_design_palette
click_ui mm_sensitivity_right
wait 0.2
expect_text "High"
click_ui mm_sensitivity_right
wait 0.2
expect_text "Low"
click_ui mm_sensitivity_right
wait 0.2
expect_text "Default"
click_ui mm_tab_5
wait 0.2
expect_text "Cross-Save"
expect_text "No account is contacted"
click_ui mm_connect
wait 0.2
expect_text "Demo account connected"
expect_text "Disconnect demo account"
assert_no_overflow
click_ui mm_tab_0
wait 0.2
click_ui mm_tutorial
wait 0.2
expect_text "Build Your First Motorway"
expect_text "Got it"
assert_no_overflow
click_ui mm_tutorial_start
wait 0.2
expect_text "Tutorial guide closed"
expect_no_text "Build Your First Motorway"
resize 1920 1080
wait 0.3
assert_ui mm_root x=0 y=0 w=1920 h=1080
assert_ui mm_tab_0 x=318 y=207 w=264 h=78
assert_ui mm_night x=1326 y=225 w=87 h=87
assert_ui mm_tutorial x=1563 y=963 w=294 h=78
assert_no_overflow
assert_within_parents
screenshot mini_motorways_settings_design_1080
resize 1024 768
wait 0.3
assert_ui mm_canvas w=1024 h=768
assert_ui mm_root x=0 y=96 w=1024 h=576
assert_ui mm_tab_0 x=170 y=206 w=141 h=42
assert_ui mm_night x=707 y=216 w=46 h=46
assert_ui mm_tutorial x=834 y=610 w=157 h=42
assert_no_overflow
assert_within_parents
screenshot mini_motorways_settings_design_narrow
click_ui mm_back
wait 0.2
expect_text "Open Settings"
click_ui mm_reopen
wait 0.2
expect_text "Night Mode"
resize 1280 720
