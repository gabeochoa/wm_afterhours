# Shop Interface Test
# Tests buy/sell tabs, item selection, and cart interaction
# on the RPG general store screen.

goto_screen shop_interface
wait 0.5

# =========================================================================
# Verify initial state
# =========================================================================
expect_text "General Store"
expect_text "Welcome, adventurer!"
expect_text "3,750"

# Buy/Sell tabs and current table headers
expect_text "Buy"
expect_text "Sell"
expect_text "ITEM"
expect_text "TYPE"
expect_text "STOCK"
expect_text "PRICE"

# Items should be listed
expect_text "Iron Sword"
expect_text "Health Potion"
expect_text "Mana Potion"
expect_text "Leather Armor"
expect_text "Fire Scroll"
expect_text "Torch"
expect_text "Antidote"

# Default selected item is Health Potion (index 1)
expect_text "Restores 50 HP instantly."
expect_text "Consumable"
expect_text "+ Add to cart"

# Basket starts with pre-populated items
expect_text "Your basket"
expect_text "5 items"
expect_text "Purchase goods"

# Bottom status
expect_text "A Select   X Add to cart   Y Remove"

screenshot shop_initial

# =========================================================================
# Test 1: Select a different item
# =========================================================================
click_ui shop_item_0
wait 0.3
expect_text "A sturdy blade for beginners."
screenshot shop_item_selected

# =========================================================================
# Test 2: Tab switching between Buy and Sell
# =========================================================================
click_ui shop_tab_1
wait 0.3
expect_text "Fair prices for spare gear"
screenshot shop_sell_tab

click_ui shop_tab_0
wait 0.3
expect_text "Goods for the road ahead"
screenshot shop_buy_tab

# =========================================================================
# Test 3: Verify cart details
# =========================================================================
expect_text "Health Potion"
expect_text "x 3"
expect_text "Torch"
expect_text "x 2"
expect_text "Total"
expect_text "Gold remaining: 3,570 G"

screenshot shop_cart_details

# =========================================================================
# Test 4: Navigate through item list and add to basket
# =========================================================================
click_ui shop_item_4
wait 0.3
expect_text "Fire Scroll"
expect_text "Casts Fireball. Deals 25 damage."
click_ui shop_add_cart
wait 0.3
expect_text "Added Fire Scroll"
expect_text "6 items"
expect_text "500 G"

screenshot shop_navigated_item

# =========================================================================
# Test 5: Verify stock indicators
# =========================================================================
expect_text "2 left"

screenshot shop_final
