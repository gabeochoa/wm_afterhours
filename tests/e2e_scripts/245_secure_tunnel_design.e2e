goto_screen secure_tunnel
resize 1280 720
wait 0.4
expect_text "Secure Tunnel"
expect_text "Disconnected"
expect_text "Demo mode"
expect_text "Connect selected server"
expect_text "Connect to Lisbon"
expect_text "Lowest latency: Reykjavik / 14 ms"
expect_text "6 locations"
expect_text "Selected"
expect_text "Change protocol"
expect_text "VPN locations"
expect_text "Account"
expect_text "Not hidden"
expect_text "No real traffic is encrypted by this demo."
assert_ui tn_root x=0 y=0 w=1280 h=720
assert_ui tn_connect x=93 y=157 w=306 h=44
assert_ui tn_server_1 x=93 y=356 w=306 h=46
assert_ui tn_protocol x=242 y=603 w=157 h=38
assert_no_overflow
assert_within_parents
screenshot secure_tunnel_design
click_ui tn_server_2
wait 0.2
expect_text "Selected server - Montreal"
expect_text "Canada / ca-02 / 41 ms"
focus_ui tn_search
type "lis"
wait 0.2
expect_text "1 locations"
key CTRL+A
type "not a city"
wait 0.2
expect_text "No locations found"
key CTRL+A
key BACKSPACE
wait 0.2
expect_text "6 locations"
focus_ui tn_protocol
key ENTER
wait 0.2
expect_text "OpenVPN"
expect_text "Disconnected"
focus_ui tn_connect
key ENTER
wait 0.3
expect_text "Negotiating"
expect_text "Connecting..."
wait 1.2
expect_text "Tunnel up"
expect_text "Demo connection active"
expect_text "Not hidden"
expect_text "Montreal - ca-02"
screenshot secure_tunnel_design_connected
click_ui tn_diagnostics
wait 0.3
expect_text "Connection diagnostics"
expect_text "Selected route: Montreal - ca-02"
expect_text "Protocol: OpenVPN"
assert_no_overflow
screenshot secure_tunnel_design_diagnostics
key ESCAPE
wait 0.3
click_ui tn_connect
wait 0.2
expect_text "Disconnected"
click_ui tn_account
wait 0.3
expect_text "Demo account"
expect_text "No account is signed in."
key ESCAPE
wait 0.3
resize 1920 1080
wait 0.3
assert_ui tn_root x=0 y=0 w=1920 h=1080
assert_ui tn_connect x=140 y=236 w=459 h=66
assert_no_overflow
assert_within_parents
screenshot secure_tunnel_design_1080
resize 1024 768
wait 0.3
assert_ui tn_root x=0 y=96 w=1024 h=576
assert_ui tn_connect x=74 y=222 w=245 h=35
assert_no_overflow
assert_within_parents
screenshot secure_tunnel_design_narrow
resize 1280 720
