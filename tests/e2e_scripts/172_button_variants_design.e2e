goto_screen button_variants
resize 1280 720
wait 0.3
expect_text "Button variants"
expect_text "Ocean Navy"
expect_text "Disabled primary"
expect_text "214 x 40px"
expect_text "100 x 32px / 16px text"
expect_text "180 x 40px / 20px text"
expect_text "214 x 48px / 24px text"
expect_text "Large outline"
expect_text "Press any enabled specimen. Its name and count appear here."
assert_ui bv_0_0 x=216 y=155 w=214 h=40
assert_ui bv_2_3 x=942 y=275 w=214 h=40
assert_ui bv_size_0 x=273 y=356 w=100 h=32
assert_ui bv_theme_0_0 x=232 y=489 w=280 h=30
assert_ui bv_theme_2_2 x=904 y=565 w=280 h=30
assert_within_parents
