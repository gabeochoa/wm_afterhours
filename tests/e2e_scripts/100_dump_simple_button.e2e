# Simple Button dump_ui test
# Dumps the UI tree for the simple_button screen and validates structure

goto_screen simple_button
wait 0.5

# Verify key text elements are visible
expect_text "Simple Button Demo"
expect_text "Go ahead, give it a click!"
expect_text "Click Me!"
expect_text "No clicks yet..."
expect_text "More Styles"
expect_text "Secondary"
expect_text "Outline"
expect_text "Small"
expect_text "Pill"

# Dump the full UI tree
dump_ui simple_button_initial

# Dump named subtrees for key elements
dump_ui simple_button_card card
dump_ui simple_button_bg bg
dump_ui simple_button_counter counter_bg
dump_ui simple_button_divider divider
