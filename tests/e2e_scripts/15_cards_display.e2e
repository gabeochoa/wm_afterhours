# Cards Display Test
# Tests card component rendering

# Navigate to the cards screen
goto_screen cards
wait 0.5

# Validate initial screen against baseline
validate_screen cards

# Verify we're on the correct screen
expect_text "Card"

assert_ui cards_bg w=1280 h=720
assert_ui cards_main x=68 y=0 w=1144 h=720
assert_ui row1_cards h=180
assert_ui row2_nested h=170
assert_ui cards_title h=40
assert_ui style_card_0 w=140 h=100
assert_ui style_card_2 w=140 h=100
assert_ui style_card_3 w=140 h=100
assert_ui nested_item_1 h=55
assert_ui nested_item_2 h=55
assert_ui nested_item_3 h=55
assert_ui nested_container h=170
assert_ui info_panel h=170
assert_ui row3_themes h=58
assert_within_parents

screenshot cards_display
