# Checkbox Toggle Test
# Tests checkbox component rendering and interaction

# Navigate to the checkboxes screen
goto_screen checkboxes
wait 0.5

# Validate initial screen against baseline
validate_screen checkboxes

# Verify we're on the correct screen
expect_text "Checkbox Components"

assert_ui bg w=1280 h=720
assert_ui card w=1144 h=720
assert_ui checkbox_title h=40
assert_ui labeled_primary h=44
assert_ui labeled_secondary h=44
assert_ui labeled_accent h=44
assert_ui box_only_heading h=28
assert_ui disabled_heading h=28
assert_ui nl_option_1 w=44 h=44
assert_ui nl_option_2 w=44 h=44
assert_ui nl_option_3 w=44 h=44
assert_ui nl_option_4 w=44 h=44
assert_ui disabled_checked h=44
assert_ui disabled_unchecked h=44
assert_ui opt_a h=44
assert_ui opt_b h=44
assert_ui opt_c h=44
assert_ui opt_d h=44
assert_ui ch_1 h=44
assert_ui ch_2 h=44
assert_ui ch_3 h=44
assert_within_parents

focus_ui labeled_primary
key ENTER
wait 0.3
expect_checkbox labeled_primary unchecked
screenshot checkboxes_after_toggle

expect_text "2 of 4 selected"
click_ui opt_b
wait 0.5
expect_checkbox opt_b checked
expect_text "3 of 4 selected"
click_ui opt_b
wait 0.5
expect_checkbox opt_b unchecked
expect_text "2 of 4 selected"
