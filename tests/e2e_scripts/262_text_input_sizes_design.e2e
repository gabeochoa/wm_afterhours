click_ui sizes_guides
wait 0.2
expect_text "Midline guides: on"
screenshot text_input_sizes_design_guides
focus_ui sizes_clear
key ENTER
wait 0.2
expect_input_text input_24px ""
expect_input_text input_100px ""
resize 1920 1080
wait 0.3
assert_ui sizes_root x=320 y=180 w=1280 h=720
assert_ui input_24px x=484 y=330 w=620 h=24
assert_ui input_100px x=484 y=698 w=620 h=100
assert_no_overflow
assert_within_parents
screenshot text_input_sizes_design_1080
resize 1024 768
wait 0.3
assert_ui sizes_root x=0 y=24 w=1024 h=720
assert_ui input_24px x=131 y=174 w=496 h=24
assert_ui input_100px x=131 y=542 w=496 h=100
expect_text "Shared field width: 496 px"
assert_no_overflow
