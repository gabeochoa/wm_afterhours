mouse_move 20 20
expect_text "motion: in flight"
expect_text "accordion: open"
wait 1
expect_text "motion: settled"
expect_text "height: 96px"
assert_ui acc_next x=100 y=404 w=420 h=44
screenshot transition_accordion_open
click_ui acc_header
mouse_move 20 20
