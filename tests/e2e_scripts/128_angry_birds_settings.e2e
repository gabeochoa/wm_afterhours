# Angry Birds settings: faithful single-screen layout and interactions.
goto_screen angry_birds_settings
resize 1280 720
wait 0.5
expect_text "SETTINGS"
expect_text "SAVE/LOAD PROGRESS"
expect_text "CREDITS"
expect_text "SUPPORT"
expect_text "TERMS AND PRIVACY"
expect_text "NOTIFICATIONS: OFF"
expect_text "LANGUAGE"
expect_text "VERSION 1.11.0.12346"
expect_text "PLAYER ID: 281676956389"
expect_no_text "AUDIO"
expect_no_text "CANCEL"
assert_ui ab_root w=1280 h=720
assert_ui ab_board x=170 y=60 w=940 h=600
assert_ui ab_music x=220 y=185 w=126 h=72
assert_ui ab_notifications x=220 y=275 w=402 h=64
assert_ui ab_save_progress x=665 y=185 w=395 h=72
assert_ui ab_close x=1068 y=88 w=64 h=64
assert_no_overflow
screenshot angry_birds_settings_single
focus_ui ab_music
key ENTER
wait 0.2
expect_text "Music disabled"
click_ui ab_music
wait 0.2
expect_text "Music enabled"
click_ui ab_sound
wait 0.2
expect_text "Sound disabled"
click_ui ab_sound
wait 0.2
expect_text "Sound enabled"
click_ui ab_vibration
wait 0.2
expect_text "Vibration disabled"
click_ui ab_vibration
wait 0.2
expect_text "Vibration enabled"
click_ui ab_notifications
wait 0.2
expect_text "NOTIFICATIONS: ON"
expect_text "Notifications enabled"
click_ui ab_language
wait 0.2
expect_text "SELECT LANGUAGE"
expect_text "CURRENT LANGUAGE: ENGLISH"
focus_ui ab_language_spanish
key ENTER
wait 0.2
expect_text "CURRENT LANGUAGE: ESPAÑOL"
expect_text "Language set to Spanish"
assert_no_overflow
screenshot angry_birds_settings_language
key ESCAPE
wait 0.2
expect_text "SAVE/LOAD PROGRESS"
click_ui ab_save_progress
wait 0.2
expect_text "CURRENT CAMPAIGN: LEVEL 12 / 30"
expect_text "SAVED SLOT: LEVEL 9 / 30"
focus_ui ab_progress_next
key ENTER
wait 0.2
expect_text "CURRENT CAMPAIGN: LEVEL 13 / 30"
click_ui ab_progress_save
wait 0.2
expect_text "SAVED SLOT: LEVEL 13 / 30"
click_ui ab_progress_next
wait 0.2
expect_text "CURRENT CAMPAIGN: LEVEL 14 / 30"
click_ui ab_progress_load
wait 0.2
expect_text "CURRENT CAMPAIGN: LEVEL 13 / 30"
expect_text "Saved progress loaded"
screenshot angry_birds_settings_progress
click_ui ab_detail_back
wait 0.2
click_ui ab_credits
wait 0.2
expect_text "ROVIO ENTERTAINMENT"
expect_text "Thank you for playing!"
click_ui ab_detail_back
wait 0.2
click_ui ab_support
wait 0.2
expect_text "OFFLINE HELP CENTER"
expect_text "Player #281-676-956"
click_ui ab_detail_back
wait 0.2
focus_ui ab_terms
key ENTER
wait 0.2
expect_text "Your settings stay on this device."
screenshot angry_birds_settings_terms
key ESCAPE
wait 0.2
expect_text "SAVE/LOAD PROGRESS"
click_ui ab_close
wait 0.2
expect_text "SETTINGS CLOSED"
expect_text "OPEN SETTINGS"
screenshot angry_birds_settings_closed
focus_ui ab_reopen
key ENTER
wait 0.2
expect_text "SETTINGS"
key ESCAPE
wait 0.2
expect_text "SETTINGS CLOSED"
click_ui ab_reopen
wait 0.2
resize 1920 1080
wait 0.3
assert_ui ab_board x=255 y=90 w=1410 h=900
assert_no_overflow
assert_within_parents
