# Approved Who's Who layout, dropdown stress, and responsive behavior.

goto_screen guess_who_lab
wait 0.5

expect_text "Player 1 / Your turn"
expect_text "Find the mystery person"
expect_text "New game"
expect_text "Does your person"
expect_text "wear glasses?"
expect_text "Yes"
expect_text "Ask question"
expect_text "24 faces left"
expect_text "Ada"
expect_text "Yuki"
expect_text "Not sure"
assert_ui gw_root x=0 y=0 w=1280 h=720
assert_ui gw_logo x=41 y=8 w=228 h=85
assert_ui gw_reset x=1066 y=29 w=170 h=42
assert_ui gw_question x=40 y=94 w=1200 h=76
assert_ui gw_trait x=58 y=126 w=282 h=36
assert_ui gw_answer x=364 y=126 w=100 h=36
assert_ui gw_ask x=488 y=120 w=208 h=44
assert_ui gw_board x=40 y=198 w=1200 h=484
assert_ui gw_face_0 x=56 y=210 w=132 h=112
assert_ui gw_note_0 x=56 y=326 w=132 h=24
assert_ui gw_face_23 x=1092 y=530 w=132 h=112
assert_ui gw_note_23 x=1092 y=646 w=132 h=24
assert_no_overflow
assert_within_parents
screenshot guess_who_mock_default

# Both question dropdowns are keyboard operable.
focus_ui gw_trait
key ENTER
wait 0.2
key DOWN
wait 0.2
key ENTER
wait 0.3
expect_text "wear a hat?"

focus_ui gw_answer
key ENTER
wait 0.2
key DOWN
wait 0.2
key ENTER
wait 0.3
expect_text "No"

click_ui gw_ask
wait 0.4
expect_text "13 faces left"
expect_text "Question 1: No! 13 possible people left."
screenshot guess_who_mock_filtered

# Card notes remain real dropdowns and Reset restores their state.
click_ui gw_reset
wait 0.3
focus_ui gw_note_0
key ENTER
wait 0.2
key DOWN
wait 0.2
key ENTER
wait 0.3
expect_text "Maybe"
click_ui gw_face_23
wait 0.2
expect_text "23 faces left"
expect_text "Yuki flipped down"
click_ui gw_reset
wait 0.3
expect_text "24 faces left"
expect_text "Not sure"

resize 1920 1080
wait 0.3
assert_ui gw_root x=0 y=0 w=1920 h=1080
assert_ui gw_logo x=62 y=12 w=342 h=128
assert_ui gw_question x=60 y=141 w=1800 h=114
assert_ui gw_board x=60 y=297 w=1800 h=726
assert_ui gw_face_0 x=84 y=315 w=198 h=168
assert_ui gw_note_0 x=84 y=489 w=198 h=36
assert_ui gw_face_23 x=1638 y=795 w=198 h=168
assert_no_overflow
assert_within_parents
