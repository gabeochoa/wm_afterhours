resize 1280 720
wait 0.3
click_ui sp_reset
wait 0.3
expect_text "Split panes"
expect_text "Preview and Details share the right pane."
expect_text "Sidebar width: 28% of workspace"
expect_text "Preview height: 62% of right pane"
expect_text "Details height:"
expect_text "Sidebar limit 15–55%"
expect_text "Preview limit 20–85%"
expect_text "Details take the rest after the 4 px divider."
assert_ui sp_outer x=48 y=84 w=1180 h=560
assert_ui sp_vertical_divider w=4
assert_ui sp_horizontal_divider h=4
assert_no_overflow
assert_within_parents
