# Parcel Corps settings values, native volume sliders, and mock geometry.

goto_screen parcel_corps_settings
resize 1280 720
wait 1

expect_text "Settings"
expect_text "Text Language"
expect_text "King's English"
expect_text "Subtitles"
expect_text "Resolution"
expect_text "2560 × 1440"
expect_text "MSAA"
expect_text "Texture Quality"
expect_text "Audio Volume"
expect_text "Music Volume"
expect_text "EDDCOATES"
expect_text "mph"

assert_ui parcel_root x=0 y=0 w=1280 h=720
assert_ui parcel_phone x=40 y=26 w=440 h=674
assert_ui parcel_language_row x=68 y=174 w=384 h=38
assert_ui parcel_subtitles_row x=68 y=216 w=384 h=38
assert_ui parcel_resolution_row x=68 y=284 w=384 h=38
assert_ui parcel_msaa_row x=68 y=364 w=384 h=46
assert_ui parcel_texture_row x=68 y=412 w=384 h=38
assert_ui parcel_quest x=520 y=34 w=400 h=108
assert_ui parcel_chat x=944 y=34 w=288 h=212
assert_ui parcel_speed x=1104 y=592 w=128 h=96

click_ui parcel_language_row
wait 0.2
expect_text "English US"

click_ui parcel_subtitles_toggle
wait 0.2

click_ui parcel_msaa_next
wait 0.2
expect_text "4x"

click_ui parcel_texture_next
wait 0.2
expect_text "Ultra"

assert_ui parcel_audio_slider x=280 y=569 w=100 h=30
assert_ui parcel_music_slider x=280 y=613 w=100 h=30
set_slider parcel_audio_slider 0.50
wait 0.2
expect_text "Audio Volume: 50%"
focus_ui parcel_audio_slider
key RIGHT
wait 0.2
expect_text "Audio Volume: 51%"
key LEFT
wait 0.2
expect_text "Audio Volume: 50%"
drag_to 25% 81.1% 34.4% 81.1%
wait 0.3
expect_text "Audio Volume: 100%"
set_slider parcel_music_slider 0.25
wait 0.2
expect_text "Music Volume: 25%"
focus_ui parcel_music_slider
key LEFT
wait 0.2
expect_text "Music Volume: 24%"

screenshot parcel_corps_settings_review

resize 1920 1080
wait 0.3
assert_ui parcel_root x=0 y=0 w=1920 h=1080
assert_ui parcel_phone x=60 y=39 w=660 h=1011
assert_ui parcel_language_row x=102 y=261 w=576 h=57
assert_ui parcel_quest x=780 y=51 w=600 h=162
assert_ui parcel_chat x=1416 y=51 w=432 h=318
assert_ui parcel_speed x=1656 y=888 w=192 h=144
assert_ui parcel_audio_slider x=420 y=854 w=150 h=45
assert_ui parcel_status x=102 y=978 w=576 h=38
set_slider parcel_music_slider 0.75
wait 0.2
expect_text "Music Volume: 75%"
focus_ui parcel_music_slider
key RIGHT
wait 0.2
expect_text "Music Volume: 76%"
screenshot parcel_corps_sliders_1080p

resize 1280 720
