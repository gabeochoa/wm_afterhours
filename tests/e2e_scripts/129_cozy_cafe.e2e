# Cozy Cafe faithful compact portrait layout.
goto_screen cozy_cafe
resize 1280 720
wait 0.5
expect_text "Blossom Cafe"
expect_text "Today's Specials"
expect_text "Customers"
expect_text "Gold: 1347"
expect_text "Customers Served: 23"
expect_text "Lavender Latte"
expect_text "Emma - Cappuccino"
assert_no_overflow
assert_within_parents
assert_ui paper_board x=290 y=15 w=700 h=690
assert_ui specials_panel x=312 y=125 w=311
assert_ui specials_inner x=323 y=203 w=287
assert_ui customers_panel x=643 y=125 w=327
assert_ui customers_inner x=654 y=203 w=303
assert_ui chat_box x=314 y=605 w=363
assert_ui music_slider x=426 y=537 w=249 h=36
assert_ui serve_next x=686 y=421 w=237
click_ui special_1
wait 0.2
focus_ui special_2
key TAB
wait 0.2
expect_focused promote_special
key ENTER
wait 0.2
expect_text "Honey Toast promoted"
expect_text "Gold: 1372"
click_ui serve_next
wait 0.2
expect_text "Customers Served: 24"
expect_text "Served Emma's order"
expect_text "Gold: 1384"
click_ui serve_next
wait 0.2
expect_text "Customers Served: 25"
expect_text "Served Oliver's order"
expect_text "Gold: 1396"
expect_no_text "Cappuccino"
expect_no_text "Croissant"
expect_text "All orders served"
click_ui serve_next
wait 0.2
expect_text "Customers Served: 25"
click_ui tool_Research
wait 0.2
expect_text "Research opened"
click_ui tool_close
wait 0.2
set_slider music_slider 0.35
wait 0.3
expect_text "Music: 35%"
screenshot cozy_cafe_review
resize 1920 1080
wait 0.3
assert_ui paper_board x=435 y=23
assert_no_overflow
assert_within_parents
