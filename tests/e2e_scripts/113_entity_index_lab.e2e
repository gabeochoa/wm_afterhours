# add_index / whereIndexed over a parent link held in a component field.
#
# Asserts Scan and Indexed lookup return the same entity IDs before
# checking the lookup-work comparison.

goto_screen entity_index_lab
wait 0.5

# Both queries find the same 24 port entities.
expect_text "Results match: 24"
expect_text "Handle resolves / same scale"

# The collection includes app entities as well as the demo graph.
expect_text "Live collection"
expect_text "Demo + app entities"
expect_text "24 ports across 6 devices"

# The indexed lookup drives the port table, so the first device's ports are on
# screen and named.
expect_text "Mixer A"
expect_text "Input L"
expect_text "Return"

# Picking another device re-runs the indexed lookup and swaps the table.
click_ui ei_dev_2
wait 0.5
expect_text "Tape Deck"

screenshot entity_index_lab
