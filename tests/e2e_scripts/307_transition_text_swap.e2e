goto_screen transitions_lab
resize 1280 720
mouse_move 20 20
wait 0.3
click_ui group_controls
click_ui ex_text_swap
mouse_move 20 20
wait 0.6
expect_text "Text states swap"
expect_text "state: 0"
expect_text "motion: settled"
click_ui swap_btn
mouse_move 20 20
expect_text "motion: in flight"
expect_text "state: 1"
wait 1
expect_text "motion: settled"
screenshot transition_text_swap_1
click_ui swap_btn
mouse_move 20 20
expect_text "state: 2"
wait 1
click_ui swap_btn
mouse_move 20 20
expect_text "state: 0"
wait 1
expect_text "motion: settled"
click_ui reset_btn
mouse_move 20 20
wait 0.3
expect_text "state: 0"
