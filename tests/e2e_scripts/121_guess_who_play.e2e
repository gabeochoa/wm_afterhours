# 26 dropdowns. Ask a question and check the right faces go down.
#
# The board asks once on load, so the eliminated styling is visible at rest
# rather than 24 identical tiles. That is why this starts at 12 and not 24.

goto_screen guess_who_lab
wait 0.5
expect_text "12 standing"
expect_text "Q1: wears glasses"

# Reset puts every face back up.
click_ui gw_reset
wait 0.4
expect_text "24 standing"

# Default question is "wears glasses, answered yes". Twelve of the 24 do.
click_ui gw_ask
wait 0.4
expect_text "12 standing"

# Asking the same thing again changes nothing, since the board already agrees.
click_ui gw_ask
wait 0.4
expect_text "12 standing"
