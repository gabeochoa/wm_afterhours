# Who's Who filtering and direct face elimination.

goto_screen guess_who_lab
wait 0.5
expect_text "24 faces left"
expect_text "A little question. A big clue."

# A portrait is a live toggle.
click_ui gw_face_0
wait 0.3
expect_text "23 faces left"
expect_text "Ada flipped down"
click_ui gw_face_0
wait 0.3
expect_text "24 faces left"
expect_text "Ada restored"

# Default question is "wear glasses? Yes". Twelve of the 24 match.
click_ui gw_ask
wait 0.4
expect_text "12 faces left"
expect_text "Question 1: Yes! 12 possible people left."

# New game restores every face, note, and question control.
click_ui gw_reset
wait 0.4
expect_text "24 faces left"
expect_text "A little question. A big clue."
assert_no_overflow
assert_within_parents
