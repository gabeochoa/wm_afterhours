# Kart Select Screen Test
# Tests character grid selection, kart selection, and action buttons
# on the racing game character/kart selection screen.

# Navigate to the kart select screen
goto_screen kart_select
wait 0.5

# =========================================================================
# Verify initial state
# =========================================================================
expect_text "SELECT YOUR RACER"
expect_text "Grand Prix - Mushroom Cup"
expect_text "P1"

# Character names should be visible in the grid
expect_text "Turbo"
expect_text "Blaze"
expect_text "Drift"
expect_text "Tank"
expect_text "Zippy"
expect_text "Rumble"
expect_text "Flash"
expect_text "Pebble"

# Default selected character is Drift (index 2)
# The preview panel should show Drift's stats
expect_text "SPD 6/10"
expect_text "ACC 6/10"
expect_text "HND 9/10"
expect_text "WGT 4/10"

# Kart options
expect_text "VEHICLE"
expect_text "Standard"
expect_text "Speedster"
expect_text "Off-Road"
expect_text "Classic"

# Bottom bar should show current selection
expect_text "Drift  +  Standard"

# Action buttons
expect_text "< Back"
expect_text "READY!"

screenshot kart_select_initial

# =========================================================================
# Test 1: Select a different character
# =========================================================================
# Tab to the character grid and select Turbo (first character)
key TAB
wait 0.2
key ENTER
wait 0.3

# Stats should update for the newly selected character
# Bottom bar should update
screenshot kart_select_character_changed

# =========================================================================
# Test 2: Select a different kart
# =========================================================================
# Tab through characters to reach the kart buttons
# There are 8 character buttons, then kart buttons
key TAB
wait 0.2
key TAB
wait 0.2
key TAB
wait 0.2
key TAB
wait 0.2
key TAB
wait 0.2
key TAB
wait 0.2
key TAB
wait 0.2
key TAB
wait 0.2

# Now we should be on kart buttons
# Select Speedster (second kart)
key TAB
wait 0.2
key ENTER
wait 0.3

screenshot kart_select_kart_changed

# =========================================================================
# Test 3: Verify stat bar labels are accessible
# =========================================================================
goto_screen kart_select
wait 0.5

# Select Flash (highest speed character) to verify stat display
# Flash is character index 6, so tab to it
key TAB
wait 0.2
key TAB
wait 0.2
key TAB
wait 0.2
key TAB
wait 0.2
key TAB
wait 0.2
key TAB
wait 0.2
key TAB
wait 0.2
key ENTER
wait 0.3

# Flash has speed=1.0, so stat should show 10/10
expect_text "SPD 10/10"
expect_text "ACC 6/10"
expect_text "HND 3/10"
expect_text "WGT 6/10"

screenshot kart_select_flash_stats

# =========================================================================
# Test 4: Bottom bar reflects combined selection
# =========================================================================
# We selected Flash above. Now select Off-Road kart.
# Tab past remaining characters to kart section
key TAB
wait 0.2
# Skip Standard kart
key TAB
wait 0.2
# Skip Speedster kart
key TAB
wait 0.2
# Select Off-Road
key ENTER
wait 0.3

expect_text "Flash  +  Off-Road"

screenshot kart_select_combined

# =========================================================================
# Test 5: Action buttons are present
# =========================================================================
# Verify the Ready and Back buttons exist
expect_text "READY!"
expect_text "< Back"
expect_text "A: Select"

screenshot kart_select_final
