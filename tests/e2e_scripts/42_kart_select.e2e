# Kart selection remains live while matching the approved racer mock.

goto_screen kart_select
wait 0.5

expect_text "SELECT YOUR RACER"
expect_text "Grand Prix · Mushroom Cup"
expect_text "P1"
expect_text "Turbo"
expect_text "Blaze"
expect_text "Drift"
expect_text "Tank"
expect_text "Zippy"
expect_text "Rumble"
expect_text "Flash"
expect_text "Pebble"
expect_text "CHOOSE YOUR VEHICLE"
expect_text "Speed"
expect_text "Acceleration"
expect_text "Handling"
expect_text "Weight"
expect_text "Standard"
expect_text "Speedster"
expect_text "Off-Road"
expect_text "Classic"
expect_text "READY!"
assert_no_overflow
assert_within_parents
screenshot kart_select_initial

# Character and vehicle cards work by pointer and keyboard.
click_ui kart_driver_0
wait 0.2
expect_text "Selected Turbo"
focus_ui kart_driver_1
key ENTER
wait 0.2
expect_text "Selected Blaze"
click_ui kart_vehicle_1
wait 0.2
expect_text "Selected Speedster"
focus_ui kart_vehicle_2
key ENTER
wait 0.2
expect_text "Selected Off-Road"

# Ready and Back are live actions.
focus_ui kart_ready
key ENTER
wait 0.2
expect_text "RACING!"
expect_text "Ready to race: Blaze + Off-Road"
click_ui kart_back
wait 0.2
expect_text "Back selected"
screenshot kart_select_final

# Restore the mock's defaults and clear transient feedback for repeat runs.
click_ui kart_driver_2
wait 0.1
click_ui kart_driver_2
wait 0.1
click_ui kart_vehicle_0
wait 0.1
click_ui kart_vehicle_0
wait 0.1
