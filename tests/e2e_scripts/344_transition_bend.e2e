goto_screen transitions_lab
resize 1280 720
mouse_move 20 20
wait 0.3
click_ui group_effects
click_ui ex_bend
mouse_move 20 20
wait 0.5
expect_text "Image bend"
expect_text "shader: ok"
expect_text "open: no"
expect_text "motion: settled"
click_ui bend_btn
mouse_move 20 20
screenshot transition_bend_opening
expect_text "open: yes"
expect_text "motion: in flight"
wait 1.5
expect_text "motion: settled"
screenshot transition_bend_open
click_ui bend_btn
mouse_move 20 20
expect_text "open: no"
expect_text "toggles: 2"
wait 1.5
expect_text "motion: settled"
