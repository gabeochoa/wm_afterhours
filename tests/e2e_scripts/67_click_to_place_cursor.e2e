# Feature: Click-to-place cursor at a specific character position
# Expected: Clicking within the text should move the cursor to the
# nearest character boundary, not just focus the field.

goto_screen text_input
wait 0.5

focus_ui Username_input
wait 0.2
type "Hello World"
wait 0.3

# Cursor is at end (after "d"). Screenshot for reference.
screenshot click_cursor_01_at_end

# Click roughly in the middle of "Hello World" (around the space)
# The field is at approximately x=350..670, y=107..143 on the text_input screen
# Middle of text would be around x=420
click 420 120
wait 0.3
screenshot click_cursor_02_clicked_middle

# Type a character - it should appear at the clicked position, not at the end
type "X"
wait 0.2
screenshot click_cursor_03_typed_after_click

# Verify the text has X inserted in the middle, not appended
expect_input_text Username_input "HelloX World"
