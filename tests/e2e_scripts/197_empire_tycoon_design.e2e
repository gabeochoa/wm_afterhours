goto_screen empire_tycoon
resize 1280 720
wait 0.4
expect_text "DREAM"
expect_text "INCORPORATED"
expect_text "$1,250,980"
expect_text "Happiness 85%"
expect_text "Resources 60%"
expect_text "Toys: 5,200 items/min"
expect_text "items/min / change from starting rate"
expect_text "20% of work remaining"
expect_text "90% of work remaining"
expect_text "Free / +$25,000 cash"
expect_text "$5,000 / +10% selected work"
expect_text "$12,000 / start Sky Garden"
expect_text "Park development 65%"
expect_text "Goal: 100% / Reward: $50,000"
expect_text "GLOBAL"
expect_text "DEVTEAM"
assert_ui empire_root x=0 y=0 w=1280 h=720
assert_ui empire_project_1 x=751 y=418 w=405 h=70
assert_ui empire_action_0 x=282 y=517 w=278 h=44
assert_within_parents
screenshot empire_design
click_ui empire_tab_2
wait 0.2
expect_text "Upgrades department selected"
click_ui empire_project_1
wait 0.2
expect_text "> Develop Robot Mascot"
click_ui empire_action_1
wait 0.2
expect_text "$1,245,980"
expect_text "Develop Robot Mascot prioritized"
expect_text "80% of work remaining"
click_ui empire_action_0
wait 0.2
expect_text "$1,270,980"
expect_text "Toys: 5,600 items/min"
expect_text "15% of work remaining"
expect_text "Park development 70%"
click_ui empire_action_2
wait 0.2
expect_text "$1,258,980"
expect_text "> Sky Garden"
expect_text "95% of work remaining"
expect_text "Expand garden"
click_ui empire_action_0
wait 0.2
click_ui empire_action_0
wait 0.2
click_ui empire_action_0
wait 0.2
click_ui empire_action_0
wait 0.2
click_ui empire_action_0
wait 0.2
click_ui empire_action_0
wait 0.2
expect_text "Park development 100%"
expect_text "$50,000 reward collected"
expect_text "Milestone complete! +$50,000 reward"
expect_text "$1,458,980"
click_ui empire_action_0
wait 0.2
expect_text "$1,483,980"
expect_text "$50,000 reward collected"
click_ui empire_tool_1
wait 0.2
expect_text "Settings opened"
resize 1920 1080
wait 0.3
assert_ui empire_root x=0 y=0 w=1920 h=1080
assert_ui empire_dashboard x=381 y=386 w=1413 h=513
