expect_text "25,000 P$"
expect_text "Offline Mode"
expect_text "SYSTEM"
expect_text "OPTIONS / SYSTEM"
expect_text "Select"
expect_text "Choose"
expect_text "Reset"
expect_text "Change tab"
expect_text "Enter"
expect_text "Esc"
expect_no_text "MainMenu"
