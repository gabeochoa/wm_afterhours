screenshot fighter_menu_design
click_ui fighter_option_3
wait 0.2
expect_text "OPTIONS / SOUND"
expect_text "Set music and sound levels, voices, and language preferences."
screenshot fighter_menu_design_sound
click_ui fighter_option_5
wait 0.2
expect_text "OPTIONS / BUTTONS"
expect_text "Remap your controller layout and keyboard bindings."
assert_ui fighter_holo_gear w=140 h=140
key UP
wait 0.2
expect_text "OPTIONS / NETWORK"
focus_ui fighter_option_1
key ENTER
wait 0.2
expect_text "OPTIONS / GAME"
key DOWN
wait 0.2
expect_text "OPTIONS / DISPLAY"
key ESCAPE
wait 0.2
expect_text "OPTIONS / SYSTEM"
click_ui fighter_previous_tab
wait 0.2
click_ui fighter_next_tab
wait 0.2
resize 1920 1080
wait 0.3
