# Offsite Backup mock parity smoke test.

goto_screen offsite_backup
wait 0.6

expect_text "Offsite Backup"
expect_text "offsite"
expect_text "MacBook Pro"
expect_text "Backing up your files"
expect_text "493 GB of 787 GB uploaded"
expect_text "2 of 5 folders complete"
expect_text "Run backup"
expect_text "Every 4 hours"
expect_text "Keep file versions"
expect_text "1 year"
expect_text "Bandwidth limit"
expect_text "62%"
expect_text "Last completed"
expect_text "2 hours ago"

assert_ui bk_root x=0 y=0 w=1280 h=720
assert_ui bk_menubar x=0 y=0 w=1280 h=28
assert_ui bk_window x=90 y=65 w=1100 h=622
assert_ui bk_nav x=90 y=100 w=1100 h=76
assert_ui bk_main x=90 y=176 w=697 h=474
assert_ui bk_aside x=787 y=176 w=403 h=474
assert_ui bk_ring x=129 y=251 w=125 h=125
assert_ui bk_rescan x=700 y=435 w=52 h=22
assert_ui bk_schedule x=1025 y=238 w=137 h=27
assert_ui bk_retention x=1025 y=284 w=137 h=27
assert_ui bk_bandwidth x=816 y=356 w=344 h=16
assert_ui bk_battery_box x=815 y=419 w=12 h=12
assert_ui bk_footer x=90 y=650 w=1100 h=37

click_ui bk_pause
wait 0.2
expect_text "Backup paused"
click_ui bk_pause
wait 0.2
expect_text "Backup resumed"

click_ui bk_schedule
wait 0.2
expect_text "Daily"
click_ui bk_retention
wait 0.2
expect_text "Forever"
click_ui bk_bandwidth
wait 0.2
expect_text "72%"
click_ui bk_external_label
wait 0.2
expect_text "External drives included"
click_ui bk_restore
wait 0.2
expect_text "Restore options opened"
click_ui bk_help
wait 0.2
expect_text "Backup help opened"
click_ui bk_rescan
wait 0.2
expect_text "Rescan started"
expect_text "FOLDERS"

screenshot offsite_backup_review

resize 1920 1080
wait 0.3
assert_ui bk_root x=0 y=0 w=1920 h=1080
assert_ui bk_menubar x=0 y=0 w=1920 h=42
assert_ui bk_window x=135 y=98 w=1650 h=933
assert_ui bk_nav x=135 y=150 w=1650 h=114
assert_ui bk_main x=135 y=264 w=1046 h=711
assert_ui bk_aside x=1181 y=264 w=605 h=711
assert_ui bk_ring x=194 y=377 w=188 h=188
assert_ui bk_schedule x=1538 y=357 w=206 h=41
assert_ui bk_bandwidth x=1224 y=534 w=516 h=24
assert_ui bk_footer x=135 y=975 w=1650 h=56
