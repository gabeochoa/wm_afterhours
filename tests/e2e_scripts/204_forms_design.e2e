goto_screen forms
resize 1280 720
wait 0.5
expect_text "Form Components"
expect_text "Sliders"
expect_text "Checkboxes"
expect_text "Volume"
expect_text "Brightness"
expect_text "Difficulty"
expect_text "Easy"
expect_text "Hard"
expect_text "Progress Bars"
expect_text "Audio Level / percentage"
expect_text "Level Progress / custom range"
expect_text "75/100"
expect_text "Audio"
expect_text "Display"
expect_text "Music"
expect_text "Sound effects"
expect_text "Music on / effects on"
expect_text "V-Sync"
expect_text "Synchronize frames with the display."
expect_no_text "Ambient Occlusion"
expect_text "More options below / scroll this list"
expect_text "Current settings"
expect_text "Resolution / demo preset"
expect_text "Quality / demo preset"
expect_text "1920x1080"
expect_text "Medium"
expect_text "Copy saves the summary as text."
expect_text "Paste reads text; it does not apply settings."
expect_text "Clipboard result / read only"
expect_text "(clipboard empty)"
assert_ui forms_bg w=1280 h=720
assert_ui left_column x=48 y=110 w=564 h=390
assert_ui right_column x=636 y=110 w=596 h=390
assert_ui volume_slider x=84 y=176 w=492 h=32
assert_ui brightness_slider x=84 y=242 w=492 h=32
assert_ui difficulty_slider x=84 y=308 w=492 h=32
assert_ui volume_progress x=68 y=428 w=524 h=8
assert_ui level_progress x=68 y=478 w=524 h=8
assert_ui forms_options x=660 y=164 w=548 h=290
assert_ui forms_music_toggle w=44 h=44
assert_ui forms_status_panel x=48 y=516 w=1184 h=63
assert_ui clipboard_row x=48 y=596 w=1184 h=106
assert_ui forms_clipboard_output x=466 y=636 w=746 h=58
assert_no_overflow
assert_within_parents
screenshot forms_design
click_ui forms_music_toggle
wait 0.2
expect_text "Music off / effects on"
focus_ui forms_sfx_toggle
key ENTER
wait 0.2
expect_text "Music off / effects off"
click_ui forms_music_toggle
click_ui forms_sfx_toggle
wait 0.2
expect_text "Music on / effects on"
mouse_down 448 192
wait 0.1
mouse_move 584 192
wait 0.2
mouse_up
wait 0.2
expect_text "100%"
click_ui copy_btn
wait 0.2
expect_text "Copied!"
click_ui paste_btn
wait 0.2
expect_text "Volume: 100% | Resolution: 1920x1080 | Quality: Medium"
mouse_move 75% 45%
scroll_wheel 0 -50
wait 0.3
expect_text "Ambient Occlusion"
expect_text "Bloom Effect"
expect_text "Disabled"
expect_text "Language"
expect_text "English"
expect_text "End of options / scroll up to Audio"
assert_no_overflow
assert_within_parents
screenshot forms_design_scrolled
mouse_move 75% 45%
scroll_wheel 0 50
wait 0.3
expect_text "Music"
expect_text "More options below / scroll this list"
resize 1920 1080
wait 0.3
assert_ui left_column x=72 y=165 w=846 h=585
assert_ui forms_options x=990 y=246 w=822 h=435
assert_ui volume_progress x=102 y=642 w=786 h=12
assert_ui forms_status_panel x=72 y=774 w=1776 h=95
assert_ui forms_clipboard_output x=699 y=954 w=1119 h=87
assert_no_overflow
assert_within_parents
