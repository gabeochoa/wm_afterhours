screenshot rubber_bandits_design
click_ui rb_menu_1
wait 0.2
expect_text "Learn the controls"
focus_ui rb_menu_3
key ENTER
wait 0.2
expect_text "Choose your loadout"
click_ui rb_menu_4
wait 0.2
expect_text "Meet the team"
click_ui rb_menu_5
wait 0.2
expect_text "OPEN MENU"
expect_no_text "CREDITS"
click_ui rb_open_menu
wait 0.2
expect_text "OPTIONS"
key ESCAPE
wait 0.2
expect_text "OPEN MENU"
key ESCAPE
wait 0.2
expect_text "CLOSE MENU"
click_ui rb_character_prev
wait 0.2
expect_text "THE OUTLAW"
expect_text "4 of 4"
assert_ui rb_selected_marker x=1091 y=545 w=98 h=16
click_ui rb_character_next
wait 0.2
expect_text "EARL THE BIRD"
expect_text "1 of 4"
focus_ui rb_character_next
key ENTER
wait 0.2
expect_text "THE GENTLEMAN"
expect_text "2 of 4"
click_ui rb_character_next
wait 0.2
expect_text "HOT HEAD"
expect_text "3 of 4"
click_ui rb_promo
wait 0.2
expect_text "Cosmetic pack preview"
expect_text "No purchase in this demo"
assert_no_overflow
screenshot rubber_bandits_design_pack
click_ui rb_promo
wait 0.2
expect_text "View pack"
