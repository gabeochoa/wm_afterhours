assert_ui rb_online_bar x=0 y=0 w=1280 h=40
assert_ui rb_logo x=52 y=78 w=330 h=183
assert_ui rb_menu_0 x=48 y=324 w=354 h=42
assert_ui rb_menu_2 x=48 y=416 w=354 h=42
assert_ui rb_menu_5 x=48 y=577 w=354 h=42
assert_ui rb_character_panel x=468 y=608 w=764 h=60
assert_ui rb_character_prev x=486 y=622 w=48 h=32
assert_ui rb_character_next x=1166 y=622 w=48 h=32
assert_ui rb_selected_marker x=659 y=568 w=98 h=16
assert_ui rb_footer x=0 y=678 w=1280 h=42
