expect_text "Coins  20"
expect_text "OPTIONS"
expect_text "CREDITS"
expect_text "CLOSE MENU"
expect_text "Supporter pack"
expect_text "View pack"
expect_text "EARL THE BIRD"
expect_text "1 of 4"
expect_text "FAVOURITE"
expect_text "Enter  Select"
