# Mini Motorways mock parity and live settings coverage.

goto_screen mini_motorways_settings
resize 1280 720
wait 0.5

expect_text "Game"
expect_text "Night Mode"
expect_text "Vibration"
expect_text "Hold to Draw/Delete"
expect_text "Controller Cursor Sensitivity"
expect_text "Default"
expect_text "Colorblind Mode"
expect_text "Mini Motorways release-10-patch-2 (202207010917)"
expect_text "Tutorial"
assert_ui mm_root x=0 y=0 w=1280 h=720
assert_ui mm_tab_0 x=212 y=138 w=176 h=52
assert_ui mm_tab_1 x=191 y=195 w=197 h=52
assert_ui mm_night x=884 y=150 w=58 h=58
assert_ui mm_vibration x=884 y=242 w=58 h=58
assert_ui mm_hold x=884 y=334 w=58 h=58
assert_ui mm_sensitivity_left x=884 y=426 w=52 h=52
assert_ui mm_sensitivity_right x=1110 y=426 w=52 h=52
assert_ui mm_colorblind x=884 y=522 w=58 h=58
assert_ui mm_tutorial x=1042 y=642 w=196 h=52
assert_no_overflow
assert_within_parents
screenshot mini_motorways_settings_default

# Game controls update real state through pointer and keyboard input.
click_ui mm_night
wait 0.2
expect_text "Night Mode on"
click_ui mm_night
wait 0.2
expect_text "Night Mode off"
focus_ui mm_vibration
key ENTER
wait 0.2
expect_text "Vibration on"
key ENTER
wait 0.2
expect_text "Vibration off"
click_ui mm_hold
wait 0.2
expect_text "Hold to Draw/Delete off"
click_ui mm_hold
wait 0.2
expect_text "Hold to Draw/Delete on"
click_ui mm_sensitivity_right
wait 0.2
expect_text "High"
click_ui mm_sensitivity_left
wait 0.2
expect_text "Default"

# Every mock tab has working content.
click_ui mm_tab_1
wait 0.2
expect_text "Fullscreen"
expect_text "1920 × 1080"
click_ui mm_resolution_right
wait 0.2
expect_text "2560 × 1440"
click_ui mm_resolution_left
wait 0.2
expect_text "1920 × 1080"

click_ui mm_tab_2
wait 0.2
expect_text "Music"
expect_text "70%"
expect_text "Sound Effects"
expect_text "90%"
set_slider mm_music_slider 0.42
wait 0.3
expect_text "42%"
set_slider mm_music_slider 0.70
wait 0.3
expect_text "70%"

click_ui mm_tab_3
wait 0.2
expect_text "English"
click_ui mm_language_left
wait 0.2
expect_text "日本語"
click_ui mm_language_right
wait 0.2
expect_text "English"

click_ui mm_tab_4
wait 0.2
expect_text "Hold to draw or delete"
expect_text "Vibration"

click_ui mm_tab_5
wait 0.2
expect_text "Local account connection demo. No account is contacted and no progress is uploaded."
expect_text "Connect demo account"
click_ui mm_connect
wait 0.2
expect_text "Disconnect demo account"
expect_text "Demo account connected"
click_ui mm_connect
wait 0.2
expect_text "Connect demo account"

click_ui mm_tab_6
wait 0.2
expect_text "Made by Dinosaur Polo Club"
expect_text "Wellington, New Zealand"

# Tutorial opens actual instructions and Escape dismisses the panel.
click_ui mm_tutorial
wait 0.2
expect_text "Build Your First Motorway"
expect_text "Got it"
assert_ui mm_tutorial_panel x=420 y=145 w=620 h=390
key ESCAPE
wait 0.2
expect_no_text "Build Your First Motorway"

# The back control closes the settings surface and it can be reopened.
click_ui mm_tab_0
wait 0.2
focus_ui mm_back
key ENTER
wait 0.2
expect_text "Open Settings"
expect_no_text "Night Mode"
focus_ui mm_reopen
key ENTER
wait 0.2
expect_text "Night Mode"

resize 1920 1080
wait 0.3
assert_ui mm_root x=0 y=0 w=1920 h=1080
assert_ui mm_tab_0 x=318 y=207 w=264 h=78
assert_ui mm_night x=1326 y=225 w=87 h=87
assert_ui mm_tutorial x=1563 y=963 w=294 h=78
assert_no_overflow
assert_within_parents

resize 1280 720
