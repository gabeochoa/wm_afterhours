# Mini Motorways mock parity and live settings coverage.

goto_screen mini_motorways_settings
resize 1280 720
wait 0.5

expect_text "Game"
expect_text "Night Mode"
expect_text "Vibration"
expect_text "Hold to draw or delete"
expect_text "Cursor sensitivity"
expect_text "Default"
expect_text "Colorblind Mode"
expect_text "Mini Motorways / 10.2"
expect_text "Tutorial guide"
assert_ui mm_root x=0 y=0 w=1280 h=720
assert_ui mm_tab_0 x=120 y=132 w=268 h=54
assert_ui mm_tab_1 x=120 y=198 w=268 h=54
assert_ui mm_night x=1144 y=159 w=44 h=44
assert_ui mm_vibration x=1144 y=251 w=44 h=44
assert_ui mm_hold x=1144 y=343 w=44 h=44
assert_ui mm_sensitivity_left x=896 y=433 w=44 h=44
assert_ui mm_sensitivity_right x=1144 y=433 w=44 h=44
assert_ui mm_colorblind x=1144 y=545 w=44 h=44
assert_ui mm_tutorial x=976 y=654 w=224 h=48
assert_no_overflow
assert_within_parents
screenshot mini_motorways_settings_default

# Game controls update real state through pointer and keyboard input.
click_ui mm_night
wait 0.2
expect_text "Night Mode on"
click_ui mm_night
wait 0.2
expect_text "Night Mode off"
focus_ui mm_vibration
key ENTER
wait 0.2
expect_text "Vibration on"
key ENTER
wait 0.2
expect_text "Vibration off"
click_ui mm_hold
wait 0.2
expect_text "Hold to draw or delete off"
click_ui mm_hold
wait 0.2
expect_text "Hold to draw or delete on"
click_ui mm_sensitivity_right
wait 0.2
expect_text "High"
click_ui mm_sensitivity_left
wait 0.2
expect_text "Default"

# Every mock tab has working content.
click_ui mm_tab_1
wait 0.2
expect_text "Fullscreen"
expect_text "1920 × 1080"
click_ui mm_resolution_right
wait 0.2
expect_text "2560 × 1440"
click_ui mm_resolution_left
wait 0.2
expect_text "1920 × 1080"

click_ui mm_tab_2
wait 0.2
expect_text "Music"
expect_text "70%"
expect_text "Sound Effects"
expect_text "90%"
set_slider mm_music_slider 0.42
wait 0.3
expect_text "42%"
set_slider mm_music_slider 0.70
wait 0.3
expect_text "70%"

click_ui mm_tab_3
wait 0.2
expect_text "English"
click_ui mm_language_left
wait 0.2
expect_text "日本語"
click_ui mm_language_right
wait 0.2
expect_text "English"

click_ui mm_tab_4
wait 0.2
expect_text "Hold to draw or delete"
expect_text "Vibration"

click_ui mm_tab_5
wait 0.2
expect_text "Local account connection demo. No account is contacted and no progress is uploaded."
expect_text "Connect demo account"
click_ui mm_connect
wait 0.2
expect_text "Disconnect demo account"
expect_text "Demo account connected"
click_ui mm_connect
wait 0.2
expect_text "Connect demo account"

click_ui mm_tab_6
wait 0.2
expect_text "Made by Dinosaur Polo Club"
expect_text "Wellington, New Zealand"

# Tutorial opens actual instructions and Escape dismisses the panel.
click_ui mm_tutorial
wait 0.2
expect_text "Build Your First Motorway"
expect_text "Got it"
assert_ui mm_tutorial_panel x=420 y=145 w=620 h=390
key ESCAPE
wait 0.2
expect_no_text "Build Your First Motorway"

# The back control closes the settings surface and it can be reopened.
click_ui mm_tab_0
wait 0.2
focus_ui mm_back
key ENTER
wait 0.2
expect_text "Open Settings"
expect_no_text "Night Mode"
focus_ui mm_reopen
key ENTER
wait 0.2
expect_text "Night Mode"

resize 1920 1080
wait 0.3
assert_ui mm_root x=0 y=0 w=1920 h=1080
assert_ui mm_tab_0 x=180 y=198 w=402 h=81
assert_ui mm_night x=1716 y=239 w=66 h=66
assert_ui mm_tutorial x=1464 y=981 w=336 h=72
assert_no_overflow
assert_within_parents

resize 1280 720
