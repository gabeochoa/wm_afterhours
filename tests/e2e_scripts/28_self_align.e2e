# Self Align Test
# Tests self-alignment system

# Navigate to the self align screen
goto_screen self_align
resize 1280 720
wait 0.5

# Validate screen against baseline
validate_screen self_align

# Verify we're on the correct screen
expect_text "SelfAlign: child alignment overrides"
expect_text "The parent stays a column"
expect_text "FlexStart"

screenshot self_align_display

