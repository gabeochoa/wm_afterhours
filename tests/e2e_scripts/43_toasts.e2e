# Toast Notifications Test
# Tests triggering all toast types, duration variants, spam,
# and the interactive undo toast with counter verification.

# Navigate to the toast showcase screen
goto_screen toasts
wait 0.5

# =========================================================================
# Verify initial state
# =========================================================================
expect_text "Toast Notifications"
expect_text "SIMPLE TOASTS"
expect_text "DURATION & SPAM"
expect_text "INTERACTIVE TOASTS"

# Buttons should be visible
expect_text "Info Toast"
expect_text "Success Toast"
expect_text "Warning Toast"
expect_text "Error Toast"
expect_text "Quick (displays 1s)"
expect_text "Long (displays 10s)"
expect_text "Custom Color"
expect_text "With Undo Action"

# Undo counter starts at 0
expect_text "Undos: 0"

screenshot toasts_initial

# =========================================================================
# Test 1: Trigger Info Toast
# =========================================================================
# Tab to Info Toast button and click it
key TAB
wait 0.2
key ENTER
wait 0.5

# Toast message should appear with counter
expect_text "info message #1"

screenshot toasts_info_triggered

# =========================================================================
# Test 2: Trigger Success Toast
# =========================================================================
key TAB
wait 0.2
key ENTER
wait 0.5

expect_text "Operation completed successfully!"

screenshot toasts_success_triggered

# =========================================================================
# Test 3: Trigger Warning Toast
# =========================================================================
key TAB
wait 0.2
key ENTER
wait 0.5

expect_text "Check your settings"

screenshot toasts_warning_triggered

# =========================================================================
# Test 4: Trigger Error Toast
# =========================================================================
key TAB
wait 0.2
key ENTER
wait 0.5

expect_text "Something went wrong!"

screenshot toasts_error_triggered

# =========================================================================
# Test 5: Quick duration toast
# =========================================================================
key TAB
wait 0.2
key ENTER
wait 0.3

expect_text "This disappears fast!"

# Wait for it to disappear (1s duration)
wait 1.5

screenshot toasts_after_quick_expired

# =========================================================================
# Test 6: Spam x5 button
# =========================================================================
# Skip the Long toast button
key TAB
wait 0.2
# Land on Spam x5
key TAB
wait 0.2
key ENTER
wait 0.5

# Should see multiple spam toasts
expect_text "Spam toast #1"

screenshot toasts_spam_triggered

# =========================================================================
# Test 7: Interactive undo toast
# =========================================================================
# Skip Custom Color button
key TAB
wait 0.2
# Land on With Undo Action button
key TAB
wait 0.2
key ENTER
wait 0.5

# Undo counter should increment
expect_text "Undos: 1"

screenshot toasts_undo_first

# Click again to verify counter increments
key ENTER
wait 0.5

expect_text "Undos: 2"

screenshot toasts_undo_second

# =========================================================================
# Test 8: Multiple info toasts increment counter
# =========================================================================
goto_screen toasts
wait 0.5

# Reset state - undo counter persists but toast counter resets with screen reload
key TAB
wait 0.2
key ENTER
wait 0.3
key ENTER
wait 0.3
key ENTER
wait 0.5

# Should see incrementing info messages
expect_text "info message #"

screenshot toasts_final
