# Toast Notifications Test
# Tests triggering toast buttons and verifying counter updates.
# Note: Toast overlay text may not appear in expect_text since toasts
# render in a separate layer. We verify button interactions and counters.

# Navigate to the toast showcase screen
goto_screen toasts
resize 1280 720
wait 0.5

# =========================================================================
# Verify initial state
# =========================================================================
expect_text "Toast Notifications"
expect_text "Simple toasts"
expect_text "Duration and stacking tests"
expect_text "Simulated action feedback"

# Buttons should be visible
expect_text "Info Toast"
expect_text "Success Toast"

# Notification counter starts at 0
expect_text "Notifications sent: 0"

screenshot toasts_initial

# =========================================================================
# Test 1: Click Info Toast button
# =========================================================================
click_ui btn_info
wait 0.5

screenshot toasts_info_triggered

# =========================================================================
# Test 2: Click Success Toast button
# =========================================================================
click_ui btn_success
wait 0.5

screenshot toasts_success_triggered

# =========================================================================
# Test 3: Click Warning Toast button
# =========================================================================
click_ui btn_warning
wait 0.5

screenshot toasts_warning_triggered

# =========================================================================
# Test 4: Click Error Toast button
# =========================================================================
click_ui btn_error
wait 0.5

screenshot toasts_error_triggered

# =========================================================================
# Test 5: Click Quick duration toast
# =========================================================================
click_ui btn_quick
wait 0.3

screenshot toasts_quick_triggered

# =========================================================================
# Test 6: Click stacking button
# =========================================================================
click_ui btn_spam
wait 0.5

screenshot toasts_spam_triggered

# =========================================================================
# Test 7: Test simulated action feedback
# =========================================================================
click_ui btn_undo
wait 0.5

screenshot toasts_undo_first

# Click again
key ENTER
wait 0.5

screenshot toasts_undo_second

# =========================================================================
# Test 8: Verify all sections remain visible
# =========================================================================
expect_text "Toast Notifications"
expect_text "Simple toasts"
expect_text "Duration and stacking tests"
expect_text "Simulated action feedback"

screenshot toasts_final
