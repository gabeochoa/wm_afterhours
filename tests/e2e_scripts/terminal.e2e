key ENTER
wait 0.2
expect_text "Counter would overflow"
type "count"
key ENTER
wait 0.2
expect_text "Counter: 5"
type "c"
wait 0.2
expect_text "Clear output"
expect_text "Add to the counter: count [amount], default 1"
