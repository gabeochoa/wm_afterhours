goto_screen chart_lab
wait 0.4
expect_text "Charts / frame timings"
expect_text "Sample 1 of 120"
click_ui chart_next
wait 0.2
expect_text "Sample 2 of 120"
click_ui chart_case_0
wait 0.2
expect_text "No samples"
click_ui chart_case_1
wait 0.2
expect_text "Sample 1 of 1"
click_ui chart_next
wait 0.2
expect_text "Sample 1 of 1"
click_ui chart_case_2
wait 0.2
click_ui chart_case_3
wait 0.2
click_ui chart_case_4
click_ui chart_live
wait 0.2
expect_text "Pause live"
click_ui chart_live
wait 0.2
expect_text "Start live"
click_ui chart_previous
key TAB
wait 0.2
key ENTER
wait 0.2
expect_text "Sample 2 of 120"
screenshot chart_lab
mouse_move 50% 40%
wait 0.2
screenshot chart_lab_hover
resize 1920 1080
wait 0.3
assert_ui chart_root w=1920 h=1080
expect_text "Charts / frame timings"
resize 1280 720
