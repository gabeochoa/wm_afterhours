# Shop interface mock parity smoke test.

goto_screen shop_interface
wait 1

expect_text "WILLOWBROOK - MARKET DISTRICT"
expect_text "General Store"
expect_text "3,750"
expect_text "Health Potion"
expect_text "Restores 50 HP instantly."
expect_text "Your basket"
expect_text "180 G"

assert_ui shop_root x=0 y=0 w=1280 h=720
assert_ui shop_wares x=38 y=163 w=750 h=500
assert_ui shop_item_1 x=53 y=301 w=720 h=46
assert_ui shop_detail x=812 y=163 w=430 h=230
assert_ui shop_basket x=812 y=410 w=430 h=253
assert_ui shop_add_cart x=831 y=327 w=392 h=42
assert_ui shop_purchase x=838 y=621 w=377 h=36

focus_ui shop_item_1
key X
wait 0.2
expect_text "6 items"
key Y
wait 0.2
expect_text "5 items"
expect_text "Removed Health Potion"
click_ui shop_item_4
wait 0.2
expect_text "Fire Scroll"
expect_text "Casts Fireball. Deals 25 damage."
expect_text "320 G"

click_ui shop_add_cart
wait 0.2
expect_text "Added Fire Scroll"
expect_text "6 items"
expect_text "500 G"

click_ui shop_purchase
wait 0.2
expect_text "3,250"
expect_text "Thank you, adventurer!"
expect_text "0 items"
expect_text "0 G"

click_ui shop_tab_1
wait 0.2
expect_text "Fair prices for spare gear"

screenshot shop_interface_review

resize 1920 1080
wait 0.3
assert_ui shop_root x=0 y=0 w=1920 h=1080
assert_ui shop_wares x=57 y=245 w=1125 h=750
assert_ui shop_item_1 x=80 y=452 w=1080 h=69
assert_ui shop_detail x=1218 y=245 w=645 h=345
assert_ui shop_basket x=1218 y=615 w=645 h=380

click_ui shop_leave
wait 0.2
expect_text "Shop closed"
expect_no_text "Your basket"
click_ui shop_reopen
wait 0.2
expect_text "Your basket"
assert_no_overflow
