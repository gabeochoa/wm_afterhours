goto_screen potion_crafting
resize 1280 720
wait 0.5
expect_text "Alchemist's Workshop"
expect_text "2,450"
assert_ui potion_title x=32 y=47 w=850 h=49
assert_ui potion_recipe_1 x=24 y=332 w=274 h=92
assert_ui potion_brew x=448 y=586 w=296 h=49
assert_no_overflow
assert_within_parents
expect_text "Ready to brew"
expect_text "47 potions brewed"
screenshot potion_crafting_initial

# Brewing consumes the selected recipe's stock exactly once.
click_ui potion_brew
wait 0.2
expect_text "Mana Elixir brewed. Restores 30 MP."
expect_text "48 potions brewed"
expect_text "Missing ingredients"
expect_text "× 9"
expect_text "× 0"
click_ui potion_brew
wait 0.2
expect_text "48 potions brewed"
expect_text "Gather the missing ingredients before brewing."

# Tabs display live stock and the completed recipe.
focus_ui potion_tab_0
key TAB
key ENTER
wait 0.2
expect_text "Ingredient inventory"
click_ui potion_ingredient_5
wait 0.2
expect_text "Star Dust awakens the final brew. Sprinkle gently and stir clockwise."
click_ui potion_tab_2
wait 0.2
expect_text "The alchemist's journal"
expect_text "Mana Elixir brewed. Restores 30 MP."
click_ui potion_tab_0
wait 0.2

# The same controls work with keyboard focus and Enter.
focus_ui potion_recipe_0
key ENTER
wait 0.2
expect_text "A little comfort for a weary traveler."
expect_text "Ready to brew"
focus_ui potion_brew
key ENTER
wait 0.2
expect_text "Healing Potion brewed. Restores 50 HP."
expect_text "49 potions brewed"
expect_text "× 3"
expect_text "× 7"
assert_no_overflow
assert_within_parents
screenshot potion_crafting_brewed

resize 1920 1080
wait 0.5
assert_ui potion_title x=48 y=71 w=1275 h=74
assert_no_overflow
assert_within_parents
screenshot potion_crafting_1080p
resize 1280 720
wait 0.2
