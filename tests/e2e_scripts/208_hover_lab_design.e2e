goto_screen hover_lab
resize 1280 720
mouse_move 10 10
wait 0.4
expect_text "Hover Lab"
expect_text "Compare direct hover, subtree hover and pointer passthrough."
expect_text "1. Direct hover"
expect_text "2. Subtree hover"
expect_text "3. Pointer passthrough"
expect_text "Entering the star removes the row highlight."
expect_text "Row stays highlighted; the star still receives clicks."
expect_text "The star ignores the pointer. The row receives the hit."
expect_text "Pointer over the star"
expect_text "Expected states / reference diagrams, not controls"
expect_text "Hover queries used by these rows"
expect_text "1. was_hot(row)"
expect_text "2. mouse_was_in_subtree(row)"
expect_text "3. was_hot(row) + ignore_pointer_events"
assert_ui hv_canvas w=1280 h=720
assert_ui hv_case_0 x=48 y=128 w=648 h=184
assert_ui hv_case_1 x=48 y=322 w=648 h=184
assert_ui hv_case_2 x=48 y=516 w=648 h=184
assert_ui hv_row_0 x=68 y=198 w=420 h=48
assert_ui hv_row_1 x=68 y=392 w=420 h=48
assert_ui hv_row_2 x=68 y=586 w=420 h=48
assert_ui hv_star_0 x=446 y=204 w=36 h=36
assert_ui hv_star_1 x=446 y=398 w=36 h=36
assert_ui hv_star_2 x=446 y=592 w=36 h=36
assert_ui hv_lit_0 text=No
assert_ui hv_lit_1 text=No
assert_ui hv_lit_2 text=No
assert_ui hv_hot_0 text=No
assert_ui hv_hot_1 text=No
assert_ui hv_hot_2 text=No
assert_ui hv_clicks_0 text=0
assert_ui hv_clicks_1 text=0
assert_ui hv_clicks_2 text=0
assert_no_overflow
assert_within_parents
