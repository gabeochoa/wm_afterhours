# Feature: Cursor positioning at specific character positions
# Expected: Keyboard navigation (HOME, END, LEFT, RIGHT) allows
# precise cursor placement, and typed characters insert at cursor.

goto_screen text_input
wait 0.5

focus_ui Username_input
wait 0.2
type "ABCDEFGHIJ"
wait 0.3

# Cursor should be at end (position 10)
expect_input_selection Username_input 10 10

# Move cursor to position 1 (after 'A')
key HOME
wait 0.1
key RIGHT
wait 0.2

# Cursor should be at position 1
expect_input_selection Username_input 1 1

# Type 'X' — should insert after 'A'
type "X"
wait 0.2

# Verify: "AXBCDEFGHIJ"
expect_input_text Username_input "AXBCDEFGHIJ"
screenshot click_pos_01_inserted_near_start
