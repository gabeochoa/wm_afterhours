goto_screen transitions_lab
resize 1280 720
mouse_move 20 20
wait 0.3
click_ui group_controls
click_ui ex_input_clear
mouse_move 20 20
wait 0.6
expect_text "Input clear"
expect_text "text: present"
expect_text "motion: settled"
click_ui clear_btn
mouse_move 20 20
expect_text "motion: in flight"
expect_text "text: cleared"
wait 1.5
expect_text "motion: settled"
screenshot transition_input_cleared
click_ui text_reset_btn
mouse_move 20 20
expect_text "motion: in flight"
expect_text "text: present"
wait 1.5
expect_text "motion: settled"
