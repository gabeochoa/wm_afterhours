goto_screen casual_settings
wait 0.5
expect_text "SETTINGS"
expect_text "PROGRESS SAVE"
expect_text "NOTIFICATIONS"
expect_text "OFF"
assert_ui casual_board x=170 y=46 w=940 h=627
assert_ui casual_music x=244 y=185 w=102 h=70
assert_ui casual_close x=1022 y=104 w=62 h=62
assert_no_overflow
assert_within_parents
screenshot casual_settings_initial

# Real Tab navigation reaches the next native icon button.
focus_ui casual_music
key TAB
key ENTER
wait 0.2
expect_text "Sound off"
click_ui casual_music
wait 0.2
expect_text "Music off"
click_ui casual_vibration
wait 0.2
expect_text "Vibration on"
click_ui casual_notifications
wait 0.2
expect_text "NOTIFICATIONS"
expect_text "ON"

# Language selection has explicit Apply and Cancel behavior.
click_ui casual_language
wait 0.2
expect_text "Choose your preferred language."
click_ui casual_language_1
wait 0.2
expect_text "Selected: Spanish"
click_ui casual_language_apply
wait 0.3
expect_text "Language: Spanish"
click_ui casual_language
wait 0.2
click_ui casual_language_2
wait 0.2
click_ui casual_dialog_close
wait 0.3
click_ui casual_about
wait 0.2
expect_text "About"
expect_text "Language: Spanish"
expect_text "Player ID: 281676956389"
assert_within_parents
screenshot casual_settings_about
key ESCAPE
wait 0.3
expect_no_text "Language: Spanish"

# Loading restores a separate slot, and saving updates that slot.
click_ui casual_progress
wait 0.2
expect_text "Current progress: level 12 / 1000 coins"
expect_text "Saved progress: level 8 / 650 coins"
click_ui casual_load
wait 0.2
expect_text "Current progress: level 8 / 650 coins"
expect_text "Progress loaded: level 8"
click_ui casual_save
wait 0.2
expect_text "Progress saved: level 8"
assert_within_parents
screenshot casual_settings_progress
click_ui casual_dialog_close
wait 0.3

# Information actions open actual content, and Escape dismisses them.
click_ui casual_credits
wait 0.2
expect_text "Made with afterhours"
key ESCAPE
wait 0.3
click_ui casual_support
wait 0.2
expect_text "How can we help?"
click_ui casual_help_audio
wait 0.2
expect_text "Green means on; blue means off."
click_ui casual_help_save
wait 0.2
expect_text "Load Progress restores the last saved slot."
key ESCAPE
wait 0.3
click_ui casual_terms
wait 0.2
expect_text "Your privacy"
key ESCAPE
wait 0.3

# Closing removes the settings panel; reopening retains preferences.
click_ui casual_close
wait 0.2
expect_text "Ready for another adventure?"
expect_no_text "NOTIFICATIONS"
expect_text "Level 8  /  650 coins"
click_ui casual_reopen
wait 0.2
expect_text "NOTIFICATIONS"
expect_text "ON"
click_ui casual_music
wait 0.2
expect_text "Music on"
resize 1920 1080
wait 0.3
assert_ui casual_board x=255 y=69 w=1410 h=941
assert_ui casual_music x=366 y=278 w=153 h=105
assert_no_overflow
assert_within_parents
screenshot casual_settings_1080p
