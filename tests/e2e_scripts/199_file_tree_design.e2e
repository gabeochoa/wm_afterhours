goto_screen file_tree
resize 1280 720
wait 0.5
expect_text "File Tree"
expect_text "Project sources"
expect_text "6 folders / 12 files in project"
expect_text "Name"
expect_text "Size"
expect_text "Select a file to read its source"
expect_text "makefile"
assert_within_parents
assert_ui main_container x=60 y=28 w=1160 h=664
assert_ui file_tree x=84 y=214 w=500 h=430
click_ui file_row_FileTreeShowcase.h
wait 0.2
expect_text "#pragma once"
assert_ui file_preview x=612 y=326 w=572 h=274
mouse_move 1000 450
scroll_wheel 0 -8
wait 0.3
expect_no_text "#pragma once"
expect_text "src/systems/screens/FileTreeShowcase.h"
screenshot file_tree_design_selected
click_ui file_row_screens
wait 0.2
expect_no_text "FileTreeShowcase.h"
expect_text "Expand or collapse with Enter"
key ENTER
wait 0.2
expect_text "FileTreeShowcase.h"
click_ui refresh_btn
wait 0.2
expect_text "FileTreeShowcase.h"
click_ui home_btn
wait 0.2
expect_text "No selection"
expect_text "Project sources"
resize 1920 1080
wait 0.3
assert_ui main_container x=90 y=42 w=1740 h=996
screenshot file_tree_design_1080
resize 1024 768
wait 0.3
assert_ui main_container x=48 y=118 w=928 h=531
click_ui file_row_makefile
wait 0.2
expect_text "Read only"
screenshot file_tree_design_narrow
resize 1280 720
