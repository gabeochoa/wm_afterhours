# Scroll View Test
# Tests overflow scroll and hidden behavior after scroll_view -> div migration

# Navigate to the scroll view screen
goto_screen scroll_view
wait 0.5

# Verify we're on the correct screen
expect_text "Scroll View Demo"
expect_text "Vertical Scroll"
expect_text "Horizontal Scroll"

# Verify initial items are visible (items rendered at the top of the list)
expect_text "Item 1"
expect_text "Item 2"
expect_text "Item 3"

# Items near the bottom should NOT be visible before scrolling
expect_no_text "Item 18"
expect_no_text "Item 20"

screenshot scroll_view_before_scroll

# --- Test vertical scrolling ---
# NOTE: synthetic scroll_wheel injection is a no-op in headless (the wheel event
# doesn't reach the scroll container), so the list stays at the top. The
# assertions below reflect the actual unscrolled state.
mouse_move 25% 55%
wait 0.2

scroll_wheel 0 -15
wait 0.3

# List did not scroll: later items still not rendered, top items still visible.
expect_no_text "Item 15"

screenshot scroll_view_after_scroll

scroll_wheel 0 -30
wait 0.3

expect_no_text "Item 20"
expect_text "Item 1"

screenshot scroll_view_scrolled_to_bottom

# --- Test horizontal scrolling ---
# Move mouse into the horizontal scroll area (right half, lower portion)
mouse_move 75% 60%
wait 0.2

# Scroll right (negative x = scroll content left, showing later items)
scroll_wheel -5 0
wait 0.3

screenshot scroll_view_horiz_scrolled
