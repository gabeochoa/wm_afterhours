output-*/

# IDE/Editor
.cache/
.claude/commands/
.claude/plugins/
.claude/skills/
.cursor/commands/
.cursor/plugins/
.cursor/settings.local.json
.cursor/skills/
.vscode/
.vs/
**/.vs
**/x64/Debug/*
**/x64/.vs/*

# Profiling
*.spall
*.gcno
*.gcov
*.collapsed
recording.trace/
build-analysis.html
build-analysis.txt

# Test artifacts
tests/screenshots/
test-failures/

# Other
.obsidian/
.xmake/*
.watchman*
.venv/*

# Note: vendor/afterhours should be a git submodule, not ignored
wm_afterhours/

# Screen mock tool (generated: screenshots, UI dumps, manifest)
mocks/shots/
mocks/trees/
mocks/screens.json

# Generated review artifacts from the mock tool.
mocks/sheets/
